{% extends 'base.html.twig' %}

{% block title %}Mon panier | Lectis{% endblock %}

{% block body %}
<div class="bg-[--bluegray-light] min-h-screen py-12">
    <section class="px-6 max-w-6xl mx-auto">

        {# Bouton Retour #}
        <a href="{{ path('app_livres') }}" class="inline-flex items-center gap-2 text-[--bluegray-deep] text-sm font-bold hover:text-[--bluegray-dark] mb-8 transition-colors">
            <i class="fa-solid fa-chevron-left"></i> 
            Continuer mes achats
        </a>

        <h1 class="text-3xl md:text-4xl font-black text-[--bluegray-dark] mb-10">Mon panier</h1>

        {% if panier is null or lignes is empty %}
            {# État Vide #}
            <div class="bg-white rounded-[3rem] p-16 text-center shadow-xl border border-[--bluegray-medium]/20">
                <div class="w-24 h-24 bg-[--bluegray-light] rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fa-solid fa-basket-shopping text-4xl text-[--bluegray-deep]"></i>
                </div>
                <h2 class="text-2xl font-bold text-[--bluegray-dark] mb-2">Votre panier est vide</h2>
                <p class="text-[--bluegray-deep] mb-8">Il semble que vous n'ayez pas encore ajouté de trésors à votre collection.</p>
                <a href="{{ path('app_livres') }}" class="inline-block px-8 py-4 bg-[--bluegray-dark] text-white font-black rounded-2xl hover:scale-105 transition-all shadow-lg uppercase tracking-widest text-sm">
                    Découvrir nos livres
                </a>
            </div>
        {% else %}

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
                
                {# COLONNE GAUCHE : LISTE DES ARTICLES (2/3) #}
                <div class="lg:col-span-2 space-y-4">
                    {% for ligne in lignes %}
                        <div class="flex flex-col sm:flex-row items-center gap-6 p-6 bg-white shadow-sm rounded-4xl border border-[--bluegray-medium]/20 transition-hover hover:shadow-md">
                            
                            {# Photo du livre #}
                            <div class="w-24 h-32 shrink-0 shadow-lg rounded-xl overflow-hidden border border-[--bluegray-light]">
                                <img src="{{ asset('assets/img/' ~ ligne.livre.photo) }}" class="w-full h-full object-cover" alt="{{ ligne.livre.titre }}">
                            </div>

                            {# Infos livre #}
                            <div class="flex-1 text-center sm:text-left">
                                <h2 class="font-black text-xl text-[--bluegray-dark] leading-tight mb-1">{{ ligne.livre.titre }}</h2>
                                <p class="text-sm text-[--bluegray-deep] mb-4 font-medium italic">{{ ligne.livre.auteur }}</p>

                                <div class="flex items-center justify-center sm:justify-start gap-4">
                                    {# Sélecteur de quantité #}
                                    <div class="flex items-center bg-[--bluegray-light]/50 rounded-xl p-1 border border-[--bluegray-light]">
                                        <button onclick="updateQtt({{ ligne.id }}, {{ ligne.quantite - 1 }})" 
                                                class="w-9 h-9 flex items-center justify-center bg-white rounded-lg shadow-sm text-[--bluegray-dark] hover:bg-[--bluegray-dark] hover:text-white transition-all font-bold">
                                            −
                                        </button>
                                        <span class="px-5 font-black text-[--bluegray-dark]">{{ ligne.quantite }}</span>
                                        <button onclick="updateQtt({{ ligne.id }}, {{ ligne.quantite + 1 }})" 
                                                class="w-9 h-9 flex items-center justify-center bg-white rounded-lg shadow-sm text-[--bluegray-dark] hover:bg-[--bluegray-dark] hover:text-white transition-all font-bold">
                                            +
                                        </button>
                                    </div>
                                    
                                    {# Supprimer #}
                                    <button class="text-red-400 hover:text-red-600 transition-colors p-2 hover:bg-red-50 rounded-full" onclick="deleteLine({{ ligne.id }})">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </div>

                            {# Prix par ligne #}
                            <div class="text-center sm:text-right min-w-[140px] border-t sm:border-t-0 sm:border-l border-[--bluegray-light] pt-4 sm:pt-0 sm:pl-6">
                                <p class="text-2xs text-[--bluegray-deep] uppercase font-black tracking-widest mb-1">Sous-total</p>
                                
                                {% if app.user and app.user.isAdherent %}
                                    <p class="text-xl font-black text-[--bluegray-dark]">
                                        {{ (ligne.livre.prixFidelite * ligne.quantite)|number_format(2, ',', ' ') }} €
                                    </p>
                                    <p class="text-2xs text-green-600 font-bold line-through opacity-50">
                                        {{ (ligne.livre.prix * ligne.quantite)|number_format(2, ',', ' ') }} €
                                    </p>
                                {% else %}
                                    <p class="text-xl font-black text-[--bluegray-dark]">
                                        {{ (ligne.livre.prix * ligne.quantite)|number_format(2, ',', ' ') }} €
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# COLONNE DROITE : RÉSUMÉ (1/3) #}
                <div class="lg:col-span-1 lg:sticky lg:top-8">
                    <div class="p-8 bg-[--bluegray-dark] rounded-[2.5rem] shadow-2xl text-white relative overflow-hidden">
                        
                        {# Décoration subtile en arrière-plan #}
                        <div class="absolute -top-10 -right-10 w-32 h-32 bg-white/5 rounded-full"></div>

                        <h2 class="text-xl font-black mb-8 flex items-center gap-3">
                            <i class="fa-solid fa-receipt opacity-50"></i> 
                            Résumé de la commande
                        </h2>

                        <div class="space-y-4 mb-8">
                            {# Affichage de l'économie Membre #}
                            {% if app.user and app.user.isAdherent %}
                                {% set totalBrut = 0 %}
                                {% for l in lignes %}{% set totalBrut = totalBrut + (l.livre.prix * l.quantite) %}{% endfor %}
                                
                                <div class="flex justify-between items-center text-sm">
                                    <span class="text-[--bluegray-medium] font-bold">Total initial</span>
                                    <span class="line-through opacity-60">{{ totalBrut|number_format(2, ',', ' ') }} €</span>
                                </div>
                                <div class="flex justify-between items-center text-sm text-green-400 font-bold bg-green-400/10 p-3 rounded-xl border border-green-400/20">
                                    <span>Remise Lectis+ (-10%)</span>
                                    <span>- {{ (totalBrut - total)|number_format(2, ',', ' ') }} €</span>
                                </div>
                            {% else %}
                                <div class="flex justify-between items-center text-sm">
                                    <span class="text-[--bluegray-medium] font-bold">Articles ({{ lignes|length }})</span>
                                    <span>{{ total|number_format(2, ',', ' ') }} €</span>
                                </div>
                            {% endif %}
                            
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-[--bluegray-medium] font-bold">Frais de port</span>
                                <span class="text-green-400 font-bold uppercase text-2xs">Offerts</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center mb-8 border-t border-white/10 pt-6">
                            <span class="text-[--bluegray-medium] font-black uppercase tracking-widest text-xs">Total TTC</span>
                            <span class="text-4xl font-black">{{ (total)|number_format(2, ',', ' ') }} €</span>
                        </div>
                        
                        <a href="{{path('app_commandes')}}" 
                           class="block w-full py-5 bg-white text-[--bluegray-dark] text-center font-black rounded-2xl hover:bg-[--bluegray-light] hover:scale-[1.02] transition-all shadow-lg uppercase tracking-widest text-sm">
                            Valider ma commande
                        </a>
                        
                        <div class="flex items-center justify-center gap-4 mt-6 opacity-40">
                            <i class="fa-brands fa-cc-visa text-2xl"></i>
                            <i class="fa-brands fa-cc-mastercard text-2xl"></i>
                            <i class="fa-solid fa-lock text-sm"></i>
                        </div>
                        <p class="text-center mt-2 text-[--bluegray-deep] text-[9px] uppercase font-bold tracking-[0.2em]">
                            Paiement sécurisé par LectisPay
                        </p>
                    </div>
                    
                    {# Petit message d'adhésion si l'user n'est pas adhérent #}
                    {% if app.user and not app.user.isAdherent %}
                        <div class="mt-4 p-4 bg-white rounded-2xl border-2 border-dashed border-[--bluegray-medium]/30 text-center">
                            <p class="text-xs text-[--bluegray-deep] font-bold">
                                <i class="fa-solid fa-star text-yellow-500 mr-1"></i> 
                                Économisez encore plus ! Devenez membre Lectis+.
                            </p>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}