{# HEADER : Teinte adoucie pour éviter un rendu trop noir #}
<header class="sticky top-0 z-50 relative bg-[--bluegray-deep] shadow-xl w-full border-b border-white/10">
  
  <div class="mx-auto flex h-20 w-full max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">

    {# 1. LOGO (On ajoute un filtre blanc pour qu'il ressorte sur le sombre) #}
    <div class="shrink-0">
        <a class="block transition hover:opacity-80" href="{{ path('app_home') }}">
          <img src="{{ asset('assets/img/logo-nonebackground.png') }}" 
               alt="Lectis Logo" 
               class="brightness-0 invert w-[120px] sm:w-[150px] lg:w-[180px]">
        </a>
    </div>

    {# 2. MENU DESKTOP #}
    <nav class="hidden lg:block">
      <ul class="flex items-center gap-8 xl:gap-12 text-sm font-black uppercase tracking-[0.18em] text-white/70">
        <li><a href="{{ path('app_home') }}" class="hover:text-white transition-colors">Accueil</a></li>
        <li><a href="{{ path('app_livres') }}" class="hover:text-white transition-colors">Nos livres</a></li>
        <li><a href="{{ path('app_contact') }}" class="hover:text-white transition-colors">Contact</a></li>
      </ul>
    </nav>

    {# 3. ACTIONS #}
    <div class="flex items-center gap-2 sm:gap-3">
      <div class="flex items-center gap-3 sm:gap-4 lg:gap-6">
        {% if app.user %}
          {# 👤 MON COMPTE #}
          <a href="{{ path('app_compte') }}" class="inline-flex text-white/80 hover:text-white transition-all hover:scale-110">
            <i class="fa-solid fa-user text-xl md:text-2xl text-white/80!"></i>
          </a>
        {% endif %}

        {# 🛒 PANIER #}
        <a id="cart-link" href="{{ path('app_panier') }}" class="relative inline-flex text-white/80 hover:text-white transition-all hover:scale-110">
          <i class="fa-solid fa-cart-shopping text-xl md:text-2xl text-white/80!"></i>
          
          {% if app.user %}
            {% set panier = app.user.paniers|last %}
            {% set cartCount = 0 %}
            {% if panier %}
              {% for ligne in panier.lignePaniers %}
                {% set cartCount = cartCount + ligne.quantite %}
              {% endfor %}
            {% endif %}
          {% else %}
            {% set cartCount = app.session.get('guest_cart_count', 0) %}
          {% endif %}

          <span
            id="cart-count-badge"
            data-cart-count-badge
            class="absolute -top-2 -right-2 bg-red-600 text-white text-[10px] font-bold w-5 h-5 items-center justify-center rounded-full ring-2 ring-[--bluegray-deep] {{ cartCount > 0 ? 'flex' : 'hidden' }}"
          >
            {{ cartCount }}
          </span>
        </a>

        {% if app.user %}
          {# 🔓 DÉCONNEXION #}
          <a href="{{ path('app_logout') }}" 
             class="hidden xl:inline-flex px-4 py-2 bg-red-600 text-white text-[10px] font-black uppercase tracking-widest rounded shadow-md hover:bg-red-700 transition-all">
            Se déconnecter
          </a>

        {% else %}
          {# 🔐 CONNEXION (Bouton clair pour trancher) #}
          <a href="{{ path('app_login') }}" 
             class="px-3 sm:px-4 lg:px-6 py-2.5 bg-white text-[--bluegray-dark] text-[10px] font-black uppercase tracking-widest rounded shadow-lg hover:bg-gray-200 transition-all text-center">
            Se connecter
          </a>
        {% endif %}
      </div>

      {# BURGER MOBILE #}
      <button
        id="menu-toggle"
        type="button"
        class="p-2 text-white lg:hidden hover:bg-white/10 rounded-lg transition-colors"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Ouvrir le menu"
      >
          <i class="fa-solid fa-bars text-2xl text-white!"></i>
      </button>
    </div>
  </div>
</header>

{# 4. MENU MOBILE (S'adapte aussi au thème sombre) #}
<nav id="mobile-menu" class="hidden fixed top-20 left-0 w-full bg-[--bluegray-deep] shadow-2xl z-40 border-t border-white/10 lg:hidden" aria-hidden="true">
  <ul class="flex flex-col items-center gap-6 px-6 py-10 text-center text-sm font-black text-white/70 uppercase tracking-widest">
    <li><a class="hover:text-white" href="{{ path('app_home') }}">Accueil</a></li>
    <li><a class="hover:text-white" href="{{ path('app_livres') }}">Nos livres</a></li>
    <li><a class="hover:text-white" href="{{ path('app_contact') }}">Contact</a></li>
    {% if app.user %}
      <li>
        <a href="{{ path('app_logout') }}" class="inline-flex items-center justify-center px-5 py-2 bg-red-600 text-white text-[10px] font-black uppercase tracking-widest rounded shadow-md hover:bg-red-700 transition-all">
          Se déconnecter
        </a>
      </li>
    {% else %}
      <li>
        <a href="{{ path('app_login') }}" class="inline-flex items-center justify-center px-5 py-2 bg-white text-[--bluegray-dark] text-[10px] font-black uppercase tracking-widest rounded shadow-md hover:bg-gray-200 transition-all">
          Se connecter
        </a>
      </li>
    {% endif %}
  </ul>
</nav>
