{% extends 'base.html.twig' %}

{% block title %}Utilisation des cookies | Lectis{% endblock %}

{% block body %}
<style>
    :root {
        --bluegray-light:   #EEF3F8;
        --bluegray-medium:  #CDD6E2;
        --bluegray-deep:    #7B8A9A;
        --bluegray-dark:    #2E3A45;
        --bluegray-accent:  #3F5366;
        --neutral-white:    #FFFFFF;
    }
    .cookies-content h2 {
        color: var(--bluegray-dark);
        font-weight: 700;
        margin-top: 2.5rem;
        margin-bottom: 1.25rem;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .cookies-content p, .cookies-content li {
        color: var(--bluegray-accent);
        line-height: 1.7;
    }
</style>

<div class="min-h-screen bg-[--bluegray-light] py-16 px-4">
    <div class="max-w-4xl mx-auto">
        
        <section class="bg-[--neutral-white] p-8 md:p-16 rounded-[2rem] shadow-xl border border-[--bluegray-medium]/30 cookies-content">
            
            {# En-tête #}
            <div class="text-center mb-12">
                <span class="text-[--bluegray-deep] font-bold uppercase tracking-[0.2em] text-xs">Confidentialité</span>
                <h1 class="text-4xl md:text-5xl font-black text-[--bluegray-dark] mt-4 mb-6 text-center">Gestion des Cookies</h1>
                <p class="text-[--bluegray-accent] text-lg max-w-lg mx-auto leading-relaxed">
                    Nous attachons une grande importance à la transparence de vos données personnelles.
                </p>
                <div class="w-16 h-1 bg-[--bluegray-medium] mx-auto mt-8 rounded-full"></div>
            </div>

            {# Définition #}
            <div class="flex flex-col md:flex-row gap-8 items-center bg-[--bluegray-light]/30 p-8 rounded-2xl border border-[--bluegray-medium]/20 mb-12">
                <div class="text-5xl">🍪</div>
                <div>
                    <h2 class="!mt-0 !mb-2">Qu’est-ce qu’un cookie ?</h2>
                    <p class="text-sm">
                        Un cookie est un petit fichier texte déposé sur votre ordinateur ou mobile lors de votre navigation. 
                        Il permet au site de mémoriser vos préférences (session, langue, panier) pour rendre votre expérience plus fluide.
                    </p>
                </div>
            </div>

            <h2>📌 Utilisation sur Lectis</h2>
            <div class="space-y-4">
                <p>
                    À ce jour, le site <strong>Lectis</strong> n’utilise <strong>aucun cookie de suivi publicitaire</strong> ou d’analyse statistique tierce.
                </p>
                <p>
                    Seuls des <strong>cookies techniques</strong> strictement nécessaires sont déposés. Ils servent à :
                </p>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
                    <li class="flex items-center gap-3 p-3 bg-white rounded-xl border border-[--bluegray-light]">
                        <span class="text-emerald-500">✔</span> Gérer votre session utilisateur
                    </li>
                    <li class="flex items-center gap-3 p-3 bg-white rounded-xl border border-[--bluegray-light]">
                        <span class="text-emerald-500">✔</span> Sécuriser vos formulaires
                    </li>
                    <li class="flex items-center gap-3 p-3 bg-white rounded-xl border border-[--bluegray-light]">
                        <span class="text-emerald-500">✔</span> Mémoriser votre panier
                    </li>
                    <li class="flex items-center gap-3 p-3 bg-white rounded-xl border border-[--bluegray-light]">
                        <span class="text-emerald-500">✔</span> Assurer la navigation entre les pages
                    </li>
                </ul>
            </div>

            <div class="p-6 bg-[--bluegray-dark] rounded-2xl my-10">
                <p class="text-sm flex items-start gap-3">
                    <span class="text-xl">⚖️</span>
                    <span class="text-white"><strong>Conformité RGPD :</strong> Si Lectis venait à utiliser des cookies non-essentiels à l'avenir, une bannière de consentement vous permettant de les accepter ou de les refuser s'affichera lors de votre première visite.</span>
                </p>
            </div>

            <h2>🛠️ Gestion via votre navigateur</h2>
            <p class="mb-6">
                Vous pouvez bloquer ou supprimer les cookies directement depuis les réglages de votre navigateur :
            </p>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
                <div class="p-4 rounded-xl border border-[--bluegray-light] group hover:bg-[--bluegray-light] transition-all">
                    <p class="font-bold text-[--bluegray-dark]">Chrome</p>
                    <p class="text-[10px] text-[--bluegray-deep] uppercase mt-1">Vie privée</p>
                </div>
                <div class="p-4 rounded-xl border border-[--bluegray-light] group hover:bg-[--bluegray-light] transition-all">
                    <p class="font-bold text-[--bluegray-dark]">Firefox</p>
                    <p class="text-[10px] text-[--bluegray-deep] uppercase mt-1">Options</p>
                </div>
                <div class="p-4 rounded-xl border border-[--bluegray-light] group hover:bg-[--bluegray-light] transition-all">
                    <p class="font-bold text-[--bluegray-dark]">Safari</p>
                    <p class="text-[10px] text-[--bluegray-deep] uppercase mt-1">Préférences</p>
                </div>
                <div class="p-4 rounded-xl border border-[--bluegray-light] group hover:bg-[--bluegray-light] transition-all">
                    <p class="font-bold text-[--bluegray-dark]">Edge</p>
                    <p class="text-[10px] text-[--bluegray-deep] uppercase mt-1">Paramètres</p>
                </div>
            </div>

            {# Footer du document #}
            <div class="mt-16 pt-8 border-t border-[--bluegray-light] text-center">
                <p class="text-[--bluegray-accent] mb-6 font-medium">Une question sur vos données ?</p>
                <div class="flex flex-col md:flex-row justify-center gap-4">
                    <a href="mailto:support@lectis.org" class="px-6 py-3 bg-[--bluegray-light] text-[--bluegray-dark] rounded-xl font-bold hover:bg-[--bluegray-medium] transition-all">
                        📧 support@lectis.org
                    </a>
                    <a href="{{ path('app_contact') }}" class="px-6 py-3 bg-[--bluegray-accent] text-white rounded-xl font-bold hover:bg-[--bluegray-dark] transition-all">
                        Formulaire de contact
                    </a>
                </div>
            </div>

        </section>

        <div class="mt-8 text-center text-[--bluegray-deep] text-xs">
            <p>Dernière mise à jour : Janvier 2026</p>
        </div>
    </div>
</div>
{% endblock %}