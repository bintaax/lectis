{% extends 'base.html.twig' %}

{% block title %}Mentions Légales | Lectis{% endblock %}

{% block body %}
<style>
    :root {
        --bluegray-light:   #EEF3F8;
        --bluegray-medium:  #CDD6E2;
        --bluegray-deep:    #7B8A9A;
        --bluegray-dark:    #2E3A45;
        --bluegray-accent:  #3F5366;
        --neutral-white:    #FFFFFF;
    }
    .legal-content h2 {
        color: var(--bluegray-dark);
        font-weight: 700;
        margin-top: 2rem;
        margin-bottom: 1rem;
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .legal-content p {
        color: var(--bluegray-accent);
        line-height: 1.6;
        margin-bottom: 1rem;
    }
</style>

<div class="min-h-screen bg-[--bluegray-light] py-16 px-4">
    <div class="max-w-5xl mx-auto">
        
        <section class="bg-[--neutral-white] p-8 md:p-16 rounded-[2rem] shadow-xl border border-[--bluegray-medium]/30 legal-content">
            
            {# En-tête #}
            <div class="text-center mb-16">
                <h1 class="text-4xl md:text-5xl font-black text-[--bluegray-dark] mt-4 mb-6">Mentions Légales</h1>
                <div class="bg-amber-50 border border-amber-200 px-6 py-3 rounded-xl inline-block">
                    <p class="text-amber-800 text-sm mb-0">
                        <strong>Note :</strong> Ce site est un projet pédagogique fictif.
                    </p>
                </div>
                <div class="w-16 h-1 bg-[--bluegray-medium] mx-auto mt-8 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                
                {# Éditeur du site #}
                <div class="space-y-4">
                    <div class="flex items-center gap-3 text-[--bluegray-dark]">
                        <i class="fa-solid fa-building text-xl"></i>
                        <h2 class="!m-0">Édition du site</h2>
                    </div>
                    <p>
                        Le présent site, accessible à l’URL <strong>www.lectis.org</strong>, est édité par :<br><br>
                        <strong>Bintou Sylla</strong><br>
                        Résidant à Paris, France<br>
                        Contact : <a href="mailto:support@lectis.org" class="font-bold underline">support@lectis.org</a>
                    </p>
                </div>

                {# Hébergement #}
                <div class="space-y-4">
                    <div class="flex items-center gap-3 text-[--bluegray-dark]">
                        <i class="fa-solid fa-server text-xl"></i>
                        <h2 class="!m-0">Hébergement</h2>
                    </div>
                    <p>
                        Le Site est hébergé par la société :<br><br>
                        <strong>OVH Cloud</strong><br>
                        2 rue Kellermann<br>
                        59100 Roubaix, France<br>
                        Contact : +33 9 72 10 10 07
                    </p>
                </div>

                {# Propriété intellectuelle #}
                <div class="md:col-span-2 p-8 bg-[--bluegray-light]/50 rounded-3xl border border-[--bluegray-medium]/20">
                    <div class="flex items-center gap-3 text-[--bluegray-dark] mb-4">
                        <i class="fa-solid fa-copyright text-xl"></i>
                        <h2 class="!m-0">Propriété intellectuelle</h2>
                    </div>
                    <p>
                        L’ensemble de ce site relève de la législation française et internationale sur le droit d’auteur et la propriété intellectuelle. Tous les droits de reproduction sont réservés, y compris pour les documents téléchargeables et les représentations iconographiques et photographiques.
                    </p>
                    <p class="text-sm italic opacity-75">
                        Les couvertures de livres et résumés utilisés sur ce site sont la propriété de leurs éditeurs respectifs et sont utilisés ici uniquement à des fins de démonstration technique.
                    </p>
                </div>

                {# Contact #}
                <div class="md:col-span-2 text-center pt-8 border-t border-[--bluegray-light]">
                    <h2 class="justify-center">Nous contacter</h2>
                    <p class="max-w-md mx-auto mb-8">
                        Pour toute question ou signalement de contenu, l'équipe de Lectis est à votre disposition.
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center gap-4">
                        <a href="{{ path('app_contact') }}" class="px-8 py-3 bg-[--bluegray-dark] text-white font-bold rounded-xl hover:bg-[--bluegray-accent] transition-all shadow-lg">
                            Formulaire de contact
                        </a>
                        <a href="mailto:support@lectis.org" class="px-8 py-3 bg-white border border-[--bluegray-medium] text-[--bluegray-dark] font-bold rounded-xl hover:bg-[--bluegray-light] transition-all">
                            Email direct
                        </a>
                    </div>
                </div>

            </div>

        </section>

        <div class="mt-8 text-center text-[--bluegray-deep] text-xs">
            <p>Lectis © 2026 - Tous droits réservés</p>
        </div>
    </div>
</div>
{% endblock %}