{% extends 'base.html.twig' %}

{% block title %}Politique de retour | Lectis{% endblock %}

{% block body %}

<div class="min-h-screen bg-[--bluegray-light] py-16 px-4">
    <div class="max-w-4xl mx-auto">
        
        <section class="bg-[--neutral-white] p-8 md:p-16 rounded-4xl shadow-xl border border-[--bluegray-medium]/30 policy-content">
            
            <div class="text-center mb-12">
                <span class="text-[--bluegray-deep] font-bold uppercase tracking-widest text-xs">Services</span>
                <h1 class="text-4xl md:text-5xl font-black text-[--bluegray-dark] mt-4 mb-6 text-center">Politique de retour</h1>
                <p class="text-[--bluegray-accent] text-lg max-w-lg mx-auto leading-relaxed">
                    Chez Lectis, nous voulons que chaque livre trouve sa place. Si vous changez d'avis, vous disposez de <strong>14 jours</strong> après réception pour nous le signaler.
                </p>
                <div class="w-16 h-1 bg-[--bluegray-medium] mx-auto mt-8 rounded-full"></div>
            </div>

            {# Section Conditions #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-12">
                <div class="p-6 bg-[--bluegray-light]/50 rounded-2xl border border-[--bluegray-medium]/20">
                    <h2 class="text-xl mt-0! mb-4!">📑 Éligibilité</h2>
                    <ul class="space-y-3 text-sm text-[--bluegray-accent]">
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-500 font-bold">✓</span>
                            <span>Le livre doit être dans son <strong>état neuf</strong> (couverture non pliée, coins non cornés).</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-500 font-bold">✓</span>
                            <span>Aucune annotation ou marque de lecture.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-amber-500 font-bold">!</span>
                            <span>Les frais d'expédition pour le retour sont à la charge du client.</span>
                        </li>
                    </ul>
                </div>

                <div class="p-6 bg-[--bluegray-light]/50 rounded-2xl border border-[--bluegray-medium]/20">
                    <h2 class="text-xl mt-0! mb-4!">🛠️ Procédure</h2>
                    <div class="space-y-4 text-sm text-[--bluegray-accent]">
                        <div class="flex gap-4">
                            <span class="shrink-0 w-6 h-6 rounded-full bg-[--bluegray-dark] text-white flex items-center justify-center text-xs font-bold">1</span>
                            <p>Contactez-nous via le <a href="{{path('app_contact')}}" class="font-bold underline text-[--bluegray-dark]">formulaire</a> ou par mail.</p>
                        </div>
                        <div class="flex gap-4">
                            <span class="shrink-0 w-6 h-6 rounded-full bg-[--bluegray-dark] text-white flex items-center justify-center text-xs font-bold">2</span>
                            <p>Attendez la validation de notre équipe (sous 24h).</p>
                        </div>
                        <div class="flex gap-4">
                            <span class="shrink-0 w-6 h-6 rounded-full bg-[--bluegray-dark] text-white flex items-center justify-center text-xs font-bold">3</span>
                            <p>Retournez le livre dans son <strong>emballage d'origine</strong> pour le protéger.</p>
                        </div>
                    </div>
                </div>
            </div>

            {# Bloc de rappel final #}
            <div class="mt-12 p-8 bg-[--bluegray-dark] rounded-2xl text-center">
                <p class="text-[--bluegray-medium] text-sm mb-4">Une question spécifique sur un livre reçu abîmé ?</p>
                <div class="flex flex-col md:flex-row justify-center items-center gap-6">
                    <a href="mailto:support@lectis.org" class="flex items-center gap-2 text-white font-bold hover:text-[--bluegray-medium] transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        support@lectis.org
                    </a>
                    <div class="hidden md:block w-px h-4 bg-[--bluegray-deep]"></div>
                    <a href="{{path('app_contact')}}" class="text-white font-bold hover:text-[--bluegray-medium] transition-colors">
                        Formulaire de contact
                    </a>
                </div>
            </div>

        </section>

        <div class="mt-8 text-center text-[--bluegray-deep] text-xs">
            <p>Conformément à l'article L221-18 du Code de la consommation sur le droit de rétractation.</p>
        </div>
    </div>
</div>
{% endblock %}