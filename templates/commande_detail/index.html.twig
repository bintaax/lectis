{% extends 'base.html.twig' %}

{% block title %}Détail commande #{{ commande.numeroCommande }} – Lectis{% endblock %}

{% block body %}
<div class="bg-[--bluegray-light] min-h-screen pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-6">
        
        {# FIL D'ARIANE #}
        <a href="{{ path('app_compte') }}" class="inline-flex items-center gap-2 text-[--bluegray-deep] text-sm font-bold hover:text-[--bluegray-dark] mb-8 transition-colors">
            <i class="fa-solid fa-chevron-left"></i> 
            Retour à mon espace personnel
        </a>

        {# HEADER DE COMMANDE #}
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-10">
            <div>
                <h1 class="text-3xl md:text-4xl font-black text-[--bluegray-dark] leading-tight">
                    Commande <span class="text-[--bluegray-deep]">#{{ commande.numeroCommande }}</span>
                </h1>
               <p class="text-[--bluegray-deep] font-medium mt-1">
    Passée le {{ commande.createdAt|date('d/m/Y') }} à {{ commande.createdAt|date('H:i') }}
</p>
            </div>
            <div class="bg-white px-6 py-3 rounded-2xl shadow-sm border border-[--bluegray-medium]/30">
                <p class="text-[10px] text-[--bluegray-deep] uppercase font-bold tracking-widest mb-1">Montant Total</p>
                <p class="text-2xl font-black text-[--bluegray-dark]">{{ commande.total | number_format(2, ',', ' ') }} €</p>
            </div>
        </div>

        {# BANDEAU D'ANNULATION #}
        {% if commande.statut.value == 'annulee' %}
            <div class="flex items-center gap-4 p-5 mb-10 bg-red-50 border-l-4 border-red-500 text-red-700 rounded-r-xl shadow-sm">
                <i class="fa-solid fa-circle-xmark text-xl"></i>
                <p class="font-bold">Cette commande a été annulée et ne sera pas traitée.</p>
            </div>
        {% endif %}

        {# CALCUL DES JOURS #}
        {% set today = "now"|date("U") %}
        {% set created = commande.createdAt|date("U") %}
        {% set diffDays = ((today - created) / 86400)|round(0, 'floor') %}

        {# TIMELINE GRAPHIQUE #}
        {% if commande.statut.value != 'annulee' %}
            <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-[--bluegray-medium]/20 mb-10">
                <h2 class="text-xs font-black uppercase tracking-[0.2em] text-[--bluegray-deep] mb-8 text-center md:text-left">Suivi de votre colis</h2>
                
                <div class="relative flex flex-col md:flex-row justify-between items-start md:items-center gap-8 md:gap-0">
                    <div class="hidden md:block absolute top-1/2 left-0 w-full h-1 bg-[--bluegray-light] -translate-y-1/2 z-0"></div>
                    
                    {% set steps = [
                        {label: 'Passée', icon: 'fa-check', day: 0},
                        {label: 'Préparation', icon: 'fa-box-open', day: 1},
                        {label: 'Livraison', icon: 'fa-truck-fast', day: 3},
                        {label: 'Livrée', icon: 'fa-solid fa-house-chimney', day: 7}
                    ] %}

                    {% for step in steps %}
                        {% set isDone = diffDays >= step.day %}
                        <div class="relative z-10 flex md:flex-col items-center gap-4 md:gap-3 w-full md:w-auto">
                            <div class="w-10 h-10 flex items-center justify-center rounded-full border-4 {{ isDone ? 'bg-[--bluegray-dark] border-white text-white' : 'bg-white border-[--bluegray-light] text-[--bluegray-medium]' }} shadow-sm transition-all">
                                <i class="fa-solid {{ step.icon }} text-xs"></i>
                            </div>
                            <p class="text-xs font-black uppercase tracking-widest {{ isDone ? 'text-[--bluegray-dark]' : 'text-[--bluegray-medium]' }}">
                                {{ step.label }}
                            </p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# ARTICLES #}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <div class="lg:col-span-2 space-y-4">
                <h3 class="text-xl font-black text-[--bluegray-dark] mb-4">Articles commandés</h3>
                <div class="bg-white rounded-3xl shadow-sm border border-[--bluegray-medium]/20 overflow-hidden">
                    {% for ligne in commande.ligneCommandes %}
                        <div class="flex items-center gap-4 p-4 border-b border-[--bluegray-light] last:border-none">
                            <div class="w-16 h-20 bg-[--bluegray-light] rounded-xl shrink-0 overflow-hidden">
                                <img src="/assets/img/{{ ligne.livre.photo }}" alt="{{ ligne.livre.titre }}" class="w-full h-full object-cover">
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-bold text-[--bluegray-dark] truncate">{{ ligne.livre.titre }}</p>
                                <p class="text-xs text-[--bluegray-deep]">PU : {{ ligne.prixUnitaire|number_format(2, ',', ' ') }} € | Qté : {{ ligne.quantite }}</p>
                            </div>
                            <div class="text-right">
                                {# MODIFICATION : On multiplie par le prixUnitaire enregistré en base #}
                                <p class="font-black text-[--bluegray-dark]">{{ (ligne.prixUnitaire * ligne.quantite) | number_format(2, ',', ' ') }} €</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# SIDEBAR ACTIONS #}
            <div class="space-y-6">
                <h3 class="text-xl font-black text-[--bluegray-dark] mb-4">Gestion</h3>
                
                <div class="bg-[--bluegray-dark] p-6 rounded-3xl text-white shadow-lg">
                    <p class="text-xs font-medium text-[--bluegray-medium] mb-4">Besoin d'aide ou changement d'avis ?</p>
                    
                    {% if commande.statut.value != 'annulee' and diffDays < 3 %}
                        <a href="{{ path('app_commande_annuler', { id: commande.id }) }}"
                           onclick="return confirm('Êtes-vous sûr de vouloir annuler cette commande ?')"
                           class="block w-full py-3 bg-red-500 hover:bg-red-600 text-white text-center text-xs font-black uppercase tracking-widest rounded-xl transition-all shadow-md">
                            Annuler la commande
                        </a>
                        <p class="text-[10px] text-[--bluegray-deep] mt-3 text-center italic">Possible jusqu'à 3 jours après l'achat.</p>
                    {% else %}
                        <div class="flex items-start gap-3 opacity-60">
                            <i class="fa-solid fa-lock text-sm mt-0.5"></i>
                            <p class="text-[11px] font-bold leading-relaxed">
                                L'annulation n'est plus possible. Contactez le support pour un retour.
                            </p>
                        </div>
                    {% endif %}
                </div>

                <button class="w-full py-4 border-2 border-[--bluegray-medium] text-xs font-black uppercase tracking-widest rounded-2xl text-[--bluegray-dark] hover:bg-white transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-file-invoice"></i> Télécharger la facture
                </button>
            </div>
        </div>

    </div>
</div>
{% endblock %}