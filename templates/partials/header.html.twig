<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lectis | Librairie en ligne</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://kit.fontawesome.com/783766bfd8.js" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="{{asset('assets/css/style.css')}}">
</head>

<body class="bg-gray-50">

{# HEADER : Même couleur que le footer (--bluegray-dark) #}
<header class="relative bg-[--bluegray-dark] shadow-xl w-full border-b border-white/5">
  
  <div class="w-full flex h-20 items-center justify-between px-4 sm:px-10 lg:px-16">

    {# 1. LOGO (On ajoute un filtre blanc pour qu'il ressorte sur le sombre) #}
    <div class="shrink-0">
        <a class="block transition hover:opacity-80" href="{{ path('app_home') }}">
          <img src="{{ asset('assets/img/logo-nonebackground.png') }}" 
               alt="Lectis Logo" 
               class="brightness-0 invert" 
               style="width: 180px;">
        </a>
    </div>

    {# 2. MENU DESKTOP #}
    <nav class="hidden md:block">
      <ul class="flex items-center gap-12 text-sm font-black uppercase tracking-widest text-white/70">
        <li><a href="{{ path('app_home') }}" class="hover:text-white transition-colors">Accueil</a></li>
        <li><a href="{{ path('app_livres') }}" class="hover:text-white transition-colors">Nos livres</a></li>
        <li><a href="{{ path('app_contact') }}" class="hover:text-white transition-colors">Contact</a></li>
      </ul>
    </nav>

    {# 3. ACTIONS #}
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-4 md:gap-8">

        {% if app.user %}
          <div class="hidden md:flex items-center gap-6">
            
            {# 👤 MON COMPTE #}
            <a href="{{ path('app_compte') }}" class="text-white/80 hover:text-white transition-all hover:scale-110">
              <i class="fa-solid fa-user text-2xl"></i>
            </a>

            {# 🛒 PANIER #}
            <a href="{{ path('app_panier') }}" class="relative text-white/80 hover:text-white transition-all hover:scale-110">
              <i class="fa-solid fa-cart-shopping text-2xl"></i>
              
              {% set panier = app.user.paniers|last %}
              {% if panier and panier.lignePaniers|length > 0 %}
                <span class="absolute -top-2 -right-2 bg-red-600 text-white text-[10px] font-bold 
                             w-5 h-5 flex items-center justify-center rounded-full ring-2 ring-[--bluegray-dark]">
                    {{ panier.lignePaniers|length }}
                </span>
              {% endif %}
            </a>
          </div>

          {# 🔓 DÉCONNEXION #}
          <a href="{{ path('app_logout') }}" 
             class="px-5 py-2 bg-red-600 text-white text-[10px] font-black uppercase tracking-widest rounded shadow-md hover:bg-red-700 transition-all">
            Quitter
          </a>

        {% else %}
          {# 🔐 CONNEXION (Bouton clair pour trancher) #}
          <a href="{{ path('app_login') }}" 
             class="px-8 py-3 bg-white text-[--bluegray-dark] text-[10px] font-black uppercase tracking-widest rounded shadow-lg hover:bg-gray-200 transition-all">
            Se connecter
          </a>
        {% endif %}
      </div>

      {# BURGER MOBILE #}
      <button id="menu-toggle" class="p-2 text-white md:hidden hover:bg-white/10 rounded-lg transition-colors">
          <i class="fa-solid fa-bars text-2xl"></i>
      </button>
    </div>
  </div>
</header>

{# 4. MENU MOBILE (S'adapte aussi au thème sombre) #}
<nav id="mobile-menu" class="hidden absolute top-20 left-0 w-full bg-[--bluegray-dark] shadow-2xl z-50 border-t border-white/5 lg:hidden">
  <ul class="flex flex-col items-center gap-6 py-10 text-sm font-black text-white/70 uppercase tracking-widest">
    <li><a class="hover:text-white" href="{{ path('app_home') }}">Accueil</a></li>
    <li><a class="hover:text-white" href="{{ path('app_livres') }}">Nos livres</a></li>
    <li><a class="hover:text-white" href="{{ path('app_contact') }}">Contact</a></li>

    {% if app.user %}
      <li class="h-px w-12 bg-white/10 my-2"></li>
      <li><a class="hover:text-white" href="{{path('app_compte')}}">Mon compte</a></li>
      <li><a class="hover:text-white" href="{{ path('app_panier') }}">Mon panier</a></li>
    {% endif %}
  </ul>
</nav>

</body>
</html>