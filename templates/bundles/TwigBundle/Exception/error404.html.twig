{% extends 'base.html.twig' %}

{% block title %}Page introuvable | Lectis{% endblock %}

{% block body %}
    <section class="relative isolate overflow-hidden px-6 py-20 md:py-28">
        <div class="absolute inset-0 -z-10 bg-linear-to-br from-[--bluegray-light] via-white to-[--bluegray-medium]/50"></div>
        <div class="absolute -top-16 right-0 -z-10 h-64 w-64 rounded-full bg-[--bluegray-medium] opacity-40 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 -z-10 h-80 w-80 rounded-full bg-[--bluegray-deep] opacity-15 blur-3xl"></div>

        <div class="mx-auto flex min-h-[60vh] max-w-6xl flex-col items-center justify-center gap-10 lg:flex-row lg:gap-16">
            <div class="w-full max-w-xl text-center lg:text-left">
                <p class="mb-4 text-sm font-black uppercase tracking-[0.35em] text-[--bluegray-accent]">
                    Erreur 404
                </p>

                <h1 class="text-5xl font-black leading-none text-[--bluegray-dark] sm:text-6xl md:text-7xl">
                    Cette page
                    <span class="block text-[--bluegray-deep]">s'est refermée.</span>
                </h1>

                <p class="mt-6 max-w-lg text-base leading-8 text-[--bluegray-accent]/90 md:text-lg">
                    Le lien que vous avez suivi n'existe plus ou l'adresse contient une erreur.
                    Revenez à l'accueil ou explorez notre catalogue pour reprendre votre lecture.
                </p>

                <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:justify-center lg:justify-start">
                    <a
                        href="{{ path('app_home') }}"
                        class="inline-flex items-center justify-center rounded-xl bg-[--bluegray-accent] px-8 py-4 text-sm font-black uppercase tracking-[0.2em] text-white shadow-lg transition-all hover:-translate-y-1 hover:bg-[--bluegray-hover]"
                    >
                        Retour a l'accueil
                    </a>
                    <a
                        href="{{ path('app_livres') }}"
                        class="inline-flex items-center justify-center rounded-xl border border-[--bluegray-deep]/20 bg-white/80 px-8 py-4 text-sm font-black uppercase tracking-[0.2em] text-[--bluegray-dark] shadow-sm backdrop-blur transition-all hover:-translate-y-1 hover:border-[--bluegray-accent] hover:text-[--bluegray-accent]"
                    >
                        Voir les livres
                    </a>
                </div>
            </div>

            <div class="w-full max-w-md">
                <div class="relative overflow-hidden rounded-4xl border border-white/70 bg-white/75 p-8 shadow-2xl backdrop-blur">
                    <div class="absolute right-6 top-6 rounded-full bg-[--bluegray-light] px-4 py-1 text-xs font-black uppercase tracking-[0.3em] text-[--bluegray-accent]">
                        Lectis
                    </div>

                    <div class="flex min-h-80 flex-col justify-between rounded-3xl bg-[--bluegray-dark] p-8 text-white">
                        <div>
                            <p class="text-sm uppercase tracking-[0.4em] text-white/50">Chapitre</p>
                            <p class="mt-3 text-7xl font-black leading-none text-white">404</p>
                        </div>

                        <div class="space-y-4">
                            <div class="h-px w-full bg-white/10"></div>
                            <p class="text-lg font-bold text-[--bluegray-light]">
                                Impossible de retrouver cette page dans notre bibliotheque.
                            </p>
                            <p class="text-sm leading-7 text-white/70">
                                Essayez une autre adresse ou utilisez la navigation pour continuer votre visite.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
