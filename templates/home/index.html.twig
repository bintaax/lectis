{% extends 'base.html.twig' %}

{% block title %}Lectis | Votre Librairie en ligne{% endblock %}

{% block body %}


<div class="bg-[--bluegray-light]">

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden px-6 pt-10">
    {# Décoration de fond #}
    <div class="absolute top-0 left-0 w-full h-full opacity-40 pointer-events-none">
        <div class="absolute top-10 right-10 w-64 h-64 bg-[--bluegray-medium] rounded-full blur-3xl"></div>
        <div class="absolute bottom-10 left-10 w-96 h-96 bg-[--bluegray-deep] rounded-full blur-[100px] opacity-20"></div>
    </div>

    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8 relative z-10">
        <div class="text-center md:text-left md:w-3/5">

            <h1 class="text-4xl md:text-6xl font-bold text-[--bluegray-dark] leading-tight mb-6">
                L'aventure commence <br> 
                <span class="text-[--bluegray-deep]">à chaque page.</span>
            </h1>
            <p class="text-base md:text-lg text-[--bluegray-accent] mb-10 max-w-lg opacity-90 leading-relaxed">
                Explorez des milliers d'ouvrages sélectionnés avec soin pour nourrir votre imaginaire et votre curiosité.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                <a href="{{path('app_livres')}}" class="px-8 py-3.5 bg-[--bluegray-accent] hover:bg-[--bluegray-hover] text-white font-bold rounded-xl shadow-lg transition-all transform hover:-translate-y-1 text-center">
                    Explorer le catalogue
                </a>
                <a href="#genres" class="px-8 py-3.5 bg-white/50 border border-[--bluegray-medium] text-[--bluegray-dark] font-bold rounded-xl hover:bg-white transition-all text-center">
                    Parcourir les thèmes
                </a>
            </div>
        </div>

        <div class="md:w-2/5 flex justify-center lg:justify-end">
            <div class="relative group max-w-[280px] md:max-w-xs"> {# Taille contrôlée ici #}
                <div class="absolute"></div>
                <img src="{{ asset('assets/img/livre.png') }}" 
                     alt="Lectis Selection"
                     class="relative z-10 w-full h-auto object-contain drop-shadow-xl animate-float">
            </div>
        </div>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 scroll-down text-[--bluegray-deep] opacity-50">
        <i class="fa-solid fa-chevron-down text-xl"></i>
    </div>
</section>

    <section class="bg-white py-12 border-y border-[--bluegray-medium]/30">
        <div class="max-w-6xl mx-auto px-6">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                <div class="flex flex-col items-center text-center">
                    <div class="text-2xl mb-2">📦</div>
                    <h4 class="font-bold text-sm text-[--bluegray-dark]">Livraison Rapide</h4>
                    <p class="text-xs text-[--bluegray-deep]">En 48h chez vous</p>
                </div>
                <div class="flex flex-col items-center text-center">
                    <div class="text-2xl mb-2">💳</div>
                    <h4 class="font-bold text-sm text-[--bluegray-dark]">Paiement Sécurisé</h4>
                    <p class="text-xs text-[--bluegray-deep]">100% crypté</p>
                </div>
                <div class="flex flex-col items-center text-center">
                    <div class="text-2xl mb-2">🏷️</div>
                    <h4 class="font-bold text-sm text-[--bluegray-dark]">Lectis+</h4>
                    <p class="text-xs text-[--bluegray-deep]">Points cumulables</p>
                </div>
                <div class="flex flex-col items-center text-center">
                    <div class="text-2xl mb-2">🌱</div>
                    <h4 class="font-bold text-sm text-[--bluegray-dark]">Éco-responsable</h4>
                    <p class="text-xs text-[--bluegray-deep]">Papier certifié</p>
                </div>
            </div>
        </div>
    </section>

    <section id="genres" class="px-6 py-20 bg-[--bluegray-medium]">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-5xl font-bold text-[--bluegray-dark] mb-4">
                    Trouvez votre univers
                </h2>
                <div class="w-20 h-1 bg-[--bluegray-accent] mx-auto rounded-full"></div>
            </div>

            <div class="flex flex-wrap justify-center gap-4">
                {% set genres = [
                    {'n': 'Romance', 'i': '💖'}, 
                    {'n': 'Fantasy', 'i': '⚔️'}, 
                    {'n': 'Horreur', 'i': '👻'}, 
                    {'n': 'BD/Mangas', 'i': '🎨'}, 
                    {'n': 'Policier', 'i': '🔍'}, 
                    {'n': 'Poésie', 'i': '✍️'}, 
                    {'n': 'Jeunesse', 'i': '🎈'}
                ] %}

                {% for genre in genres %}
                    <a href="#" class="flex items-center gap-3 px-6 py-3 bg-[--bluegray-light] hover:bg-[--bluegray-dark] hover:text-white rounded-full shadow-sm transition-all duration-300 group">
                        <span>{{ genre.i }}</span>
                        <span class="font-semibold">{{ genre.n }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>


    <section id="best-sellers" class="px-6 py-24 max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
            <div class="text-left">
                <h2 class="text-4xl md:text-6xl font-black text-[--bluegray-dark]">
                    Les Incontournables
                </h2>
                <p class="text-[--bluegray-deep] mt-4 max-w-md">
                    Les lectures qui font vibrer notre communauté en ce moment.
                </p>
            </div>
            <a href="{{path('app_livres')}}" class="text-[--bluegray-accent] font-bold border-b-2 border-[--bluegray-accent] hover:text-[--bluegray-hover] transition-all">
                Tout voir
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
            {% for livre in bestSellers %}
                <div class="bg-white rounded-[1.5rem] p-5 shadow-sm hover:shadow-2xl transition-all group border border-transparent hover:border-[--bluegray-medium]">
                    
                    <div class="relative overflow-hidden rounded-xl h-72 mb-6 shadow-md">
                        <img src="/assets/img/{{ livre.photo }}" 
                             alt="{{ livre.titre }}" 
                             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-lg text-xs font-bold text-[--bluegray-dark]">
                            Best Seller
                        </div>
                    </div>

                    <div class="space-y-2">
                        <h3 class="font-bold text-xl text-[--bluegray-dark] line-clamp-1">
                            {{ livre.titre }}
                        </h3>
                        <p class="text-[--bluegray-deep] text-sm">Par {{ livre.auteur }}</p>
                    </div>

                    <a href="{{ path('app_detail', { slug: livre.slug }) }}" 
                       class="mt-6 flex items-center justify-center gap-2 w-full py-3 bg-[--bluegray-light] text-[--bluegray-dark] font-bold rounded-xl hover:bg-[--bluegray-accent] hover:text-white transition-all">
                        Détails
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="bg-[--bluegray-dark] py-20 px-6 overflow-hidden relative">
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Ne manquez aucun chapitre.</h2>
            <p class="text-[--bluegray-medium] mb-10 opacity-80">Recevez nos sélections mensuelles et des offres exclusives Lectis+.</p>
            
            <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
                <input type="email" placeholder="Votre email" class="flex-1 px-6 py-4 rounded-xl outline-none focus:ring-2 focus:ring-[--bluegray-deep]">
                <button class="px-8 py-4 bg-[--bluegray-accent] hover:bg-[--bluegray-hover] text-white font-bold rounded-xl transition-all">
                    S'inscrire
                </button>
            </form>
        </div>
    </section>

</div>

{# Animation d'entrée #}
<script>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('opacity-100', 'translate-y-0');
                entry.target.classList.remove('opacity-0', 'translate-y-10');
            }
        });
    });
    // On pourrait ajouter des classes d'animation ici
</script>
{% endblock %}