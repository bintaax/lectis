{% extends 'base.html.twig' %}

{% block title %}Lectis | Votre Librairie en ligne{% endblock %}

{% block body %}


<div class="bg-[--bluegray-light]">

<section class="relative flex min-h-[75vh] items-center justify-center overflow-hidden px-5 pt-10 sm:px-6 lg:min-h-[85vh]">
    {# Décoration de fond #}
    <div class="absolute top-0 left-0 w-full h-full opacity-40 pointer-events-none">
        <div class="absolute top-10 right-10 w-64 h-64 bg-[--bluegray-medium] rounded-full blur-3xl"></div>
        <div class="absolute bottom-10 left-10 w-96 h-96 bg-[--bluegray-deep] rounded-full blur-[100px] opacity-20"></div>
    </div>

    <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center gap-10 md:flex-row md:gap-8">
        <div class="min-w-0 text-center md:w-3/5 md:text-left">

            <h1 class="mb-6 text-4xl font-bold leading-tight text-[--bluegray-dark] sm:text-5xl md:text-6xl">
                L'aventure commence <br> 
                <span class="text-[--bluegray-deep]">à chaque page.</span>
            </h1>
            <p class="mb-10 max-w-xl text-base leading-relaxed text-[--bluegray-accent] opacity-90 md:text-lg">
                Explorez des milliers d'ouvrages sélectionnés avec soin pour nourrir votre imaginaire et votre curiosité.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                <a href="{{path('app_livres')}}" class="px-8 py-3.5 bg-[--bluegray-deep] hover:bg-[--bluegray-hover] text-white font-bold rounded-xl shadow-lg transition-all transform hover:-translate-y-1 text-center">
                    Explorer le catalogue
                </a>
            </div>
        </div>

        <div class="flex w-full justify-center md:w-2/5 lg:justify-end">
            <div class="relative group w-full max-w-[220px] sm:max-w-[260px] md:max-w-xs"> {# Taille contrôlée ici #}
                <div class="absolute"></div>
                <img src="{{ asset('assets/img/livre.png') }}" 
                     alt="Lectis Selection"
                     class="relative z-10 w-full h-auto object-contain drop-shadow-xl animate-float">
            </div>
        </div>
    </div>

</section>

    <section class="border-y border-[--bluegray-medium]/30 bg-white py-12">
        <div class="mx-auto max-w-6xl px-5 sm:px-6">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
                <div class="flex flex-col items-center text-center">
                    <div class="text-2xl mb-2">📦</div>
                    <h4 class="font-bold text-sm text-[--bluegray-dark]">Livraison Rapide</h4>
                    <p class="text-xs text-[--bluegray-deep]">En 48h chez vous</p>
                </div>
                <div class="flex flex-col items-center text-center">
                    <div class="text-2xl mb-2">💳</div>
                    <h4 class="font-bold text-sm text-[--bluegray-dark]">Paiement Sécurisé</h4>
                    <p class="text-xs text-[--bluegray-deep]">100% crypté</p>
                </div>
                <div class="flex flex-col items-center text-center">
                    <div class="text-2xl mb-2">🏷️</div>
                    <h4 class="font-bold text-sm text-[--bluegray-dark]">Lectis+</h4>
                    <p class="text-xs text-[--bluegray-deep]">Points cumulables</p>
                </div>
                <div class="flex flex-col items-center text-center">
                    <div class="text-2xl mb-2">🌱</div>
                    <h4 class="font-bold text-sm text-[--bluegray-dark]">Éco-responsable</h4>
                    <p class="text-xs text-[--bluegray-deep]">Papier certifié</p>
                </div>
            </div>
        </div>
    </section>

    <section id="genres" class="bg-[--bluegray-medium] px-5 py-20 sm:px-6">
        <div class="mx-auto max-w-6xl">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-5xl font-bold text-[--bluegray-dark] mb-4">
                    Trouvez votre univers
                </h2>
                <div class="w-20 h-1 bg-[--bluegray-accent] mx-auto rounded-full"></div>
            </div>

            <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
                {% set genres = [
                    {'n': 'Romance', 'i': '💖'}, 
                    {'n': 'Fantasy', 'i': '⚔️'}, 
                    {'n': 'Horreur', 'i': '👻'}, 
                    {'n': 'BD/Mangas', 'i': '🎨'}, 
                    {'n': 'Policier', 'i': '🔍'}, 
                    {'n': 'Poésie', 'i': '✍️'}, 
                    {'n': 'Jeunesse', 'i': '🎈'}
                ] %}

                {% for genre in genres %}
                    <a class="flex items-center gap-3 rounded-full bg-[--bluegray-light] px-4 py-3 text-sm shadow-sm transition-all duration-300 group hover:bg-[--bluegray-dark] hover:text-white sm:px-6">
                        <span>{{ genre.i }}</span>
                        <span class="font-semibold">{{ genre.n }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>


    <section id="best-sellers" class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="mb-12 flex flex-col gap-6 md:mb-16 md:flex-row md:items-end md:justify-between">
            <div class="min-w-0 text-left">
                <h2 class="text-4xl md:text-6xl font-black text-[--bluegray-dark]">
                    Les Incontournables
                </h2>
                <p class="text-[--bluegray-deep] mt-4 max-w-md">
                    Les lectures qui font vibrer notre communauté en ce moment.
                </p>
            </div>
            <a href="{{path('app_livres')}}" class="text-[--bluegray-accent] font-bold border-b border-[--bluegray-accent]/70 pb-0.5 sm:border-b-2 sm:border-[--bluegray-accent] hover:text-[--bluegray-hover] transition-all">
                Tout voir
            </a>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
            {% for livre in bestSellers %}
                <div class="bg-white rounded-3xl p-5 shadow-sm hover:shadow-2xl transition-all group border border-transparent hover:border-[--bluegray-medium]">
                    
                    <div class="relative overflow-hidden rounded-xl h-72 mb-6 shadow-md">
                        <img src="/assets/img/{{ livre.photo }}" 
                             alt="{{ livre.titre }}" 
                             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        <div class="absolute top-3 right-3 inline-flex items-center gap-1.5 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-lg text-xs font-bold text-[--bluegray-dark] shadow-sm">
                            <i class="fa-solid fa-award text-[--accent-gold]"></i>
                            <span>Best Seller</span>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <h3 class="font-bold text-xl text-[--bluegray-dark] line-clamp-1">
                            {{ livre.titre }}
                        </h3>
                        <p class="text-[--bluegray-deep] text-sm">Par {{ livre.auteur }}</p>
                    </div>

                    <a href="{{ path('app_detail', { slug: livre.slug }) }}" 
                       class="mt-6 flex items-center justify-center gap-2 w-full py-3 bg-[--bluegray-light] text-[--bluegray-dark] font-bold rounded-xl hover:bg-[--bluegray-accent] hover:text-white transition-all">
                        Détails
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>
            {% endfor %}
        </div>
    </section>

</div>
{% endblock %}
