{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil | Lectis{% endblock %}

{% block body %}


<div class="bg-[--bluegray-light] min-h-screen py-20 px-6">
    <div class="max-w-xl mx-auto">

        <div class="bg-white rounded-4xl shadow-xl border border-[--bluegray-medium]/20 p-8 md:p-12">
            
            <div class="text-center mb-10">
                <div class="w-16 h-16 bg-[--bluegray-light] rounded-full flex items-center justify-center text-[--bluegray-dark] text-2xl mx-auto mb-4">
                    <i class="fa-solid fa-user-pen"></i>
                </div>
                <h1 class="text-2xl md:text-3xl font-black text-[--bluegray-dark]">Modifier mon profil</h1>
                <p class="text-[--bluegray-deep] text-sm mt-2">Mettez à jour vos informations personnelles.</p>
            </div>

            {{ form_start(form, {'attr': {'class': 'space-y-2'}}) }}
                
                <div class="space-y-1">
                    {{ form_row(form.prenom, {
                        'label': 'Votre prénom',
                        'attr': {'placeholder': 'Ex: Jean'}
                    }) }}
                </div>

                <div class="space-y-1">
                    {{ form_row(form.nom, {
                        'label': 'Votre nom',
                        'attr': {'placeholder': 'Ex: Dupont'}
                    }) }}
                </div>

                <div class="space-y-1">
                    {{ form_row(form.email, {
                        'label': 'Adresse email',
                        'attr': {'placeholder': 'votre@email.com'}
                    }) }}
                </div>

                <div class="pt-6">
                    <button type="submit" class="w-full py-4 bg-[--bluegray-dark] text-white font-black rounded-2xl hover:bg-[--bluegray-accent] transition-all shadow-lg uppercase tracking-widest text-xs">
                        Enregistrer les modifications
                    </button>
                    
                    <a href="{{ path('app_compte') }}" class="block text-center mt-6 text-[--bluegray-deep] text-xs font-bold hover:underline">
                        Annuler et revenir en arrière
                    </a>
                </div>

            {{ form_end(form) }}

        </div>

        {# Note de sécurité #}
        <div class="mt-8 flex items-center justify-center gap-2 text-[--bluegray-deep] text-xs italic">
            <i class="fa-solid fa-shield-halved"></i>
            Vos données sont protégées et ne sont jamais partagées.
        </div>
    </div>
</div>
{% endblock %}