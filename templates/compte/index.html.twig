{% extends 'base.html.twig' %}

{% block title %}Mon compte | Lectis{% endblock %}

{% block body %}


<div class="bg-[--bluegray-light] min-h-screen py-16">
    <div class="max-w-5xl mx-auto px-6">

        {# Titre & Badge Lectis+ #}
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
            <div>
                <h1 class="text-4xl md:text-5xl font-black text-[--bluegray-dark]">Mon compte</h1>
                <p class="text-[--bluegray-deep] mt-2 font-medium">Gérez vos informations et suivez vos lectures.</p>
            </div>
            
            {% if app.user and app.user.isAdherent %}
                <div class="bg-[--bluegray-dark] text-white px-6 py-3 rounded-2xl flex items-center gap-3 shadow-lg border border-amber-400/30">
                    <span class="text-xl">✨</span>
                    <span class="text-sm font-black uppercase tracking-widest text-amber-400">Membre Lectis +</span>
                </div>
            {% endif %}
        </div>

        {# Flash Messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 p-4 rounded-2xl flex items-center gap-3 border 
                    {% if type == 'success' %} border-emerald-200 bg-emerald-50 text-emerald-800 {% else %} border-red-200 bg-red-50 text-red-800 {% endif %}">
                    <i class="fa-solid {% if type == 'success' %}fa-circle-check{% else %}fa-circle-exclamation{% endif %}"></i>
                    <span class="text-sm font-bold">{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        {# RÉSUMÉ PROFIL #}
        <div class="bg-white rounded-4xl p-8 shadow-sm border border-[--bluegray-medium]/20 mb-10 flex flex-col md:flex-row gap-8 items-center">
            <div class="w-20 h-20 bg-[--bluegray-light] rounded-full flex items-center justify-center text-[--bluegray-dark] text-3xl font-black">
                {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
            </div>
            
            <div class="flex-1 text-center md:text-left">
                <p class="text-[--bluegray-deep] text-xs font-bold uppercase tracking-widest mb-1">Session active</p>
                <h2 class="text-2xl font-black text-[--bluegray-dark]">{{ app.user.prenom }} {{ app.user.nom }}</h2>
                <p class="text-[--bluegray-accent]">{{ app.user.email }}</p>
            </div>

            <div class="flex gap-8">
                <div class="text-center">
                    <p class="text-xs font-bold text-[--bluegray-deep] uppercase mb-1">Commandes</p>
                    <p class="text-2xl font-black text-[--bluegray-dark]">{{ commandes|length }}</p>
                </div>
            </div>

            {% if not app.user.isAdherent %}
                <a href="{{ path('app_compte_lectis_plus') }}" class="px-6 py-3 bg-[--bluegray-dark] text-white rounded-xl font-bold text-sm hover:bg-[--bluegray-accent] transition-all shadow-md">
                    Devenir Adhérent Lectis +
                </a>
            {% endif %}
        </div>

        {# NAVIGATION ONGLETS #}
        <div class="flex gap-4 mb-8 overflow-x-auto no-scrollbar border-b border-[--bluegray-medium]/30 pb-px">
            <button data-tab="profil" class="tab-button active px-6 py-3 text-sm font-bold transition-all whitespace-nowrap">
                <i class="fa-solid fa-user-gear mr-2"></i>Profil
            </button>
       {#      <button data-tab="adresse" class="tab-button px-6 py-3 text-sm font-bold text-[--bluegray-deep] transition-all whitespace-nowrap">
                <i class="fa-solid fa-location-dot mr-2"></i>Adresse
            </button> #}
            <button data-tab="commandes" class="tab-button px-6 py-3 text-sm font-bold text-[--bluegray-deep] transition-all whitespace-nowrap">
                <i class="fa-solid fa-box-open mr-2"></i>Commandes
            </button>
        </div>

        {# PANELS #}
        <div class="tab-content">
            
            {# 1. PROFIL #}
            <section id="tab-profil" class="tab-panel space-y-8 animate-fadeIn">
                <div class="bg-white rounded-3xl p-8 shadow-sm border border-[--bluegray-medium]/20">
                    <h3 class="text-xl font-black text-[--bluegray-dark] mb-6">Informations personnelles</h3>
                    <div class="grid md:grid-cols-2 gap-6 mb-8">
                        <div>
                            <label class="text-2xs uppercase font-black text-[--bluegray-deep] tracking-widest">Prénom</label>
                            <p class="text-[--bluegray-dark] font-bold p-3 bg-[--bluegray-light]/30 rounded-lg mt-1">{{ app.user.prenom }}</p>
                        </div>
                        <div>
                            <label class="text-2xs uppercase font-black text-[--bluegray-deep] tracking-widest">Nom</label>
                            <p class="text-[--bluegray-dark] font-bold p-3 bg-[--bluegray-light]/30 rounded-lg mt-1">{{ app.user.nom }}</p>
                        </div>
                    </div>
                    
                    <div class="flex flex-wrap gap-4 pt-6 border-t border-[--bluegray-light]">
                        <a href="{{path('app_compte_modifier')}}" class="text-sm font-bold text-[--bluegray-accent] hover:text-[--bluegray-dark] flex items-center gap-2">
                            <i class="fa-solid fa-pen-to-square"></i> Modifier mon profil
                        </a>
                        <a href="{{path('app_compte_password')}}" class="text-sm font-bold text-[--bluegray-accent] hover:text-[--bluegray-dark] flex items-center gap-2">
                            <i class="fa-solid fa-lock"></i> Changer mon mot de passe
                        </a>
                    </div>

                    <form method="post" action="{{ path('app_compte_supprimer') }}" class="mt-12 pt-6 border-t border-red-50" onsubmit="return confirm('Cette action est irréversible. Confirmer ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                        <button type="submit" class="text-xs font-bold bg-red-500 text-white hover:bg-red-600 p-2 rounded-4xl transition-colors uppercase tracking-widest">
                            <i class="fa-solid fa-trash-can mr-2 text-white"></i> Supprimer mon compte
                        </button>
                    </form>
                </div>
            </section>

            {# 2. ADRESSE #}
  {#           <section id="tab-adresse" class="tab-panel hidden animate-fadeIn">
                <div class="bg-white rounded-3xl p-8 shadow-sm border border-[--bluegray-medium]/20">
                    <h3 class="text-xl font-black text-[--bluegray-dark] mb-6">Adresse de livraison par défaut</h3>
                    {% if adresseForm is defined and adresseForm %}
                        {{ form_start(adresseForm, {'attr': {'class': 'space-y-6'}}) }}
                            {{ form_row(adresseForm.adresse) }}
                            <div class="grid md:grid-cols-2 gap-6">
                                {{ form_row(adresseForm.codePostal) }}
                                {{ form_row(adresseForm.ville) }}
                            </div>
                            <button class="px-8 py-3 bg-[--bluegray-dark] text-white rounded-xl font-bold shadow-lg hover:bg-[--bluegray-accent] transition-all">
                                Mettre à jour l'adresse
                            </button>
                        {{ form_end(adresseForm) }}
                    {% endif %}
                </div>
            </section> #}

            {# 3. COMMANDES #}
            <section id="tab-commandes" class="tab-panel hidden animate-fadeIn">
                {% if commandes is empty %}
                    <div class="text-center py-20 bg-white rounded-3xl border border-[--bluegray-medium]/20">
                        <i class="fa-solid fa-ghost text-4xl text-[--bluegray-light] mb-4"></i>
                        <p class="text-[--bluegray-deep]">Vous n'avez pas encore passé de commande.</p>
                        <a href="{{ path('app_livres') }}" class="mt-6 inline-block text-[--bluegray-dark] font-black underline">Parcourir les livres</a>
                    </div>
                {% else %}
                    <div class="grid gap-4">
                        {% for commande in commandes %}
                            <div class="bg-white p-6 rounded-2xl border border-[--bluegray-medium]/20 shadow-sm flex flex-col md:flex-row justify-between items-center gap-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 bg-[--bluegray-light] rounded-xl flex items-center justify-center text-[--bluegray-dark]">
                                        <i class="fa-solid fa-receipt"></i>
                                    </div>
                                    <div>
                                        <p class="font-black text-[--bluegray-dark]">#{{ commande.numeroCommande }}</p>
                                     {#    <p class="text-xs text-[--bluegray-deep] uppercase font-bold tracking-tighter">{{ commande.statut.label }}</p> #}
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="text-xl font-black text-[--bluegray-dark]">{{ commande.total|number_format(2, ',', ' ') }} €</p>
                                    <a href="{{ path('app_commande_detail', { numeroCommande: commande.numeroCommande }) }}" class="text-xs font-bold text-[--bluegray-accent] hover:text-[--bluegray-dark] underline">Voir le détail</a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>
    </div>
</div>

{% endblock %}