{% extends 'base.html.twig' %}

{% block title %}Mon compte | Lectis{% endblock %}

{% block body %}


<div class="bg-[--bluegray-light] min-h-screen py-14">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">

        {# Flash Messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-5 p-3.5 rounded-2xl flex items-center gap-3 border 
                    {% if type == 'success' %} border-emerald-200 bg-emerald-50 text-emerald-800 {% else %} border-red-200 bg-red-50 text-red-800 {% endif %}">
                    <i class="fa-solid {% if type == 'success' %}fa-circle-check{% else %}fa-circle-exclamation{% endif %}"></i>
                    <span class="text-sm font-bold">{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="mb-10">
            <h1 class="text-3xl md:text-4xl font-black text-[--bluegray-dark]">Mon compte</h1>
            <p class="text-[--bluegray-accent] mt-2 text-sm max-w-2xl">
                Gérez votre profil, consultez vos commandes et pilotez votre formule Lectis+ depuis un espace simple et clair.
            </p>
        </div>

        <div class="space-y-6">
            <div class="relative px-2 md:px-4 pt-2 pb-4">
                <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-8">
                    <div class="flex items-start gap-5">
                        <div class="w-16 h-16 rounded-[1.35rem] bg-[--bluegray-dark] text-white flex items-center justify-center text-xl font-black shadow-xl">
                            {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                        </div>
                        <div>
                            <h2 class="text-2xl md:text-3xl font-black text-[--bluegray-dark]">{{ app.user.prenom }} {{ app.user.nom }}</h2>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-4">
                        <div class="min-w-[120px] rounded-2xl bg-white/80 backdrop-blur border border-white shadow-sm px-4 py-3 text-center">
                            <p class="text-2xs uppercase font-black tracking-widest text-[--bluegray-deep] mb-1">Commandes</p>
                            <p class="text-xl font-black text-[--bluegray-dark]">{{ commandes|length }}</p>
                        </div>
                        <div class="min-w-[140px] rounded-2xl bg-white/80 backdrop-blur border border-white shadow-sm px-4 py-3 text-center">
                            <p class="text-2xs uppercase font-black tracking-widest text-[--bluegray-deep] mb-1">Points lecture</p>
                            <p class="text-xl font-black text-[--bluegray-dark]">{{ pointsLecture }}</p>
                        </div>
                        <div class="min-w-[150px] rounded-2xl {{ app.user.isAdherent ? 'bg-amber-50 border-amber-200' : 'bg-white/80 border-white' }} backdrop-blur border shadow-sm px-4 py-3 text-center">
                            <p class="text-2xs uppercase font-black tracking-widest {{ app.user.isAdherent ? 'text-amber-700' : 'text-[--bluegray-deep]' }} mb-1">Formule</p>
                            <p class="text-sm font-black {{ app.user.isAdherent ? 'text-amber-900' : 'text-[--bluegray-dark]' }}">{{ app.user.isAdherent ? 'Lectis+' : 'Standard' }}</p>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex flex-wrap gap-3">
                    <button data-tab="profil" class="tab-button px-5 py-2.5 rounded-2xl text-xs font-black transition-all whitespace-nowrap">
                        <i class="fa-solid fa-user-gear mr-2"></i>Profil
                    </button>
                    <button data-tab="commandes" class="tab-button px-5 py-2.5 rounded-2xl text-xs font-black transition-all whitespace-nowrap">
                        <i class="fa-solid fa-box-open mr-2"></i>Commandes
                    </button>
                </div>
            </div>

            <div class="tab-content space-y-8">
                <section id="tab-profil" class="tab-panel animate-fadeIn space-y-8">
                    <div class="grid xl:grid-cols-[1.2fr,0.8fr] gap-8">
                        <div class="bg-[--bluegray-light]/35 rounded-[1.75rem] border border-[--bluegray-medium]/15 p-7 md:p-8">
                            <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[--bluegray-deep] mb-4">Informations personnelles</p>
                            <div class="grid md:grid-cols-2 gap-5">
                                <div class="rounded-[1.25rem] bg-white border border-[--bluegray-medium]/15 p-4 shadow-sm">
                                    <p class="text-2xs uppercase font-black tracking-widest text-[--bluegray-deep] mb-2">Prénom</p>
                                    <p class="text-xl font-black text-[--bluegray-dark]">{{ app.user.prenom }}</p>
                                </div>
                                <div class="rounded-[1.25rem] bg-white border border-[--bluegray-medium]/15 p-4 shadow-sm">
                                    <p class="text-2xs uppercase font-black tracking-widest text-[--bluegray-deep] mb-2">Nom</p>
                                    <p class="text-xl font-black text-[--bluegray-dark]">{{ app.user.nom }}</p>
                                </div>
                                <div class="rounded-[1.25rem] bg-white border border-[--bluegray-medium]/15 p-4 shadow-sm md:col-span-2">
                                    <p class="text-2xs uppercase font-black tracking-widest text-[--bluegray-deep] mb-2">Adresse email</p>
                                    <p class="text-lg font-black text-[--bluegray-dark] break-all">{{ app.user.email }}</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-[--bluegray-dark] text-white rounded-[1.75rem] p-7 md:p-8 shadow-xl">
                            <p class="text-[11px] font-black uppercase tracking-[0.3em] text-white/60 mb-4">À votre main</p>
                          
                            <p class="text-white/75 text-sm leading-relaxed mb-6">
                                Mettez à jour vos informations, changez votre mot de passe, consultez vos commandes et gérez votre formule Lectis+ sans quitter cette page.
                            </p>

                            <div class="space-y-3">
                                <a href="{{ path('app_compte_modifier') }}" class="flex items-center justify-between rounded-2xl bg-white text-[--bluegray-dark] px-4 py-3.5 text-sm font-black hover:scale-[1.01] transition-all">
                                    <span><i class="fa-solid fa-pen-to-square mr-3"></i>Modifier mon profil</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                                <a href="{{ path('app_compte_password') }}" class="flex items-center justify-between rounded-2xl bg-white/10 px-4 py-3.5 text-sm font-black hover:bg-white/15 transition-colors">
                                    <span><i class="fa-solid fa-lock mr-3"></i>Changer mon mot de passe</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
        
                            </div>
                        </div>
                    </div>

                    <div class="grid xl:grid-cols-[0.95fr,1.05fr] gap-8">
                        <div class="bg-white rounded-[1.75rem] border border-[--bluegray-medium]/20 p-7 md:p-8 shadow-sm">
                            <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[--bluegray-deep] mb-4">Lectis+</p>
                            <div class="rounded-[1.25rem] {{ app.user.isAdherent ? 'bg-amber-50 border-amber-200' : 'bg-[--bluegray-light]/35 border-[--bluegray-medium]/15' }} border p-5">
                                <div class="flex items-center justify-between gap-4 mb-5">
                                    <div>
                                        <p class="text-2xs uppercase font-black tracking-widest {{ app.user.isAdherent ? 'text-amber-700' : 'text-[--bluegray-deep]' }}">Solde actuel</p>
                                        <p class="mt-2 text-3xl font-black {{ app.user.isAdherent ? 'text-amber-900' : 'text-[--bluegray-dark]' }}">{{ pointsLecture }} pts</p>
                                    </div>
                                    <div class="w-14 h-14 rounded-2xl {{ app.user.isAdherent ? 'bg-amber-100 text-amber-800' : 'bg-white text-[--bluegray-dark]' }} flex items-center justify-center text-xl shadow-sm">
                                        <i class="fa-solid fa-book-open-reader"></i>
                                    </div>
                                </div>
                                <p class="text-xl font-black {{ app.user.isAdherent ? 'text-amber-900' : 'text-[--bluegray-dark]' }}">
                                    {{ app.user.isAdherent ? 'Vous profitez de Lectis+' : 'Vous êtes sur la formule standard' }}
                                </p>
                                <p class="mt-3 text-sm leading-relaxed {{ app.user.isAdherent ? 'text-amber-800' : 'text-[--bluegray-accent]' }}">
                                    {{ app.user.isAdherent ? 'Vous pouvez conserver ce statut ou revenir à une formule classique quand vous le souhaitez.' : 'Activez Lectis+ pour profiter de fonctionnalités exclusives.' }}
                                </p>
                                <p class="mt-3 text-xs font-black uppercase tracking-widest {{ app.user.isAdherent ? 'text-amber-700' : 'text-[--bluegray-deep]' }}">
                                    1 € dépensé = 1 point lecture
                                </p>

                                {% if app.user.isAdherent and app.user.adherentAt %}
                                    <p class="mt-4 text-xs font-black uppercase tracking-widest text-amber-700">
                                        Membre depuis {{ app.user.adherentAt|date('d/m/Y') }}
                                    </p>
                                {% endif %}

                                <div class="mt-6">
                                    {% if not app.user.isAdherent %}
                                        <a href="{{ path('app_compte_lectis_plus') }}" class="inline-flex w-full items-center justify-center gap-3 px-5 py-3.5 rounded-2xl bg-[--bluegray-dark] text-white text-xs font-black uppercase tracking-widest hover:scale-[1.02] transition-all">
                                            <i class="fa-solid fa-crown"></i>
                                            Découvrir Lectis+
                                        </a>
                                    {% else %}
                                        <form method="post" action="{{ path('app_compte_lectis_plus_quitter') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('lectis_plus_leave') }}">
                                            <button type="submit" class="inline-flex w-full items-center justify-center gap-3 px-5 py-3.5 rounded-2xl bg-white border border-amber-300 text-amber-800 text-xs font-black uppercase tracking-widest hover:bg-amber-100 transition-colors">
                                                <i class="fa-solid fa-user-minus"></i>
                                                Quitter Lectis+
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-[1.75rem] border border-red-200 p-7 md:p-8 shadow-sm">
                            <p class="text-[11px] font-black uppercase tracking-[0.3em] text-red-500 mb-4">Zone sensible</p>
                            <h3 class="text-xl font-black text-[--bluegray-dark] mb-3">Supprimer mon compte</h3>
                            <p class="text-sm text-[--bluegray-accent] leading-relaxed mb-6">
                                Cette action désactive définitivement votre compte. Vos anciennes commandes sont conservées à des fins de suivi, mais votre profil sera anonymisé.
                            </p>
                            <button
                                type="button"
                                data-modal-open="delete-account-modal"
                                class="inline-flex items-center gap-3 px-5 py-3.5 rounded-2xl bg-red-500 text-white text-xs font-black uppercase tracking-widest hover:bg-red-600 transition-colors shadow-md"
                            >
                                <i class="fa-solid fa-trash-can"></i>
                                Supprimer mon compte
                            </button>
                        </div>
                    </div>
                </section>

                <section id="tab-commandes" class="tab-panel hidden animate-fadeIn space-y-6">
                    <div class="bg-[--bluegray-light]/35 rounded-[1.75rem] border border-[--bluegray-medium]/15 p-7 md:p-8">
                        <p class="text-[11px] font-black uppercase tracking-[0.3em] text-[--bluegray-deep] mb-3">Commandes</p>
                        <h3 class="text-2xl md:text-3xl font-black text-[--bluegray-dark]">Votre historique en un coup d’œil.</h3>
                        <p class="text-[--bluegray-accent] text-sm mt-3">
                            Retrouvez ici toutes vos commandes passées, leur statut et un accès direct à chaque détail.
                        </p>
                    </div>

                    {% if commandes is empty %}
                        <div class="text-center py-16 bg-white rounded-[1.75rem] border border-[--bluegray-medium]/20">
                            <i class="fa-solid fa-ghost text-3xl text-[--bluegray-light] mb-4"></i>
                            <p class="text-[--bluegray-deep] text-sm">Vous n'avez pas encore passé de commande.</p>
                            <a href="{{ path('app_livres') }}" class="mt-6 inline-block text-[--bluegray-dark] font-black underline">Parcourir les livres</a>
                        </div>
                    {% else %}
                        <div class="grid gap-5">
                            {% for commande in commandes %}
                                <div class="bg-white p-5 rounded-3xl border border-[--bluegray-medium]/20 shadow-sm flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 bg-[--bluegray-light] rounded-xl flex items-center justify-center text-[--bluegray-dark]">
                                            <i class="fa-solid fa-receipt"></i>
                                        </div>
                                        <div>
                                            <p class="font-black text-[--bluegray-dark]">#{{ commande.numeroCommande }}</p>
                                            {% set statut = commande.statutSimule %}
                                            <span class="inline-flex items-center px-3 py-1 mt-2 rounded-full text-2xs font-black uppercase {{ statut.badgeClass() }}">
                                                {{ statut.label() }}
                                            </span>
                                        </div>
                                    </div>

                                    <div class="lg:text-right">
                                        <p class="text-xl font-black text-[--bluegray-dark]">{{ commande.total|number_format(2, ',', ' ') }} €</p>
                                        <a href="{{ path('app_commande_detail', { numeroCommande: commande.numeroCommande }) }}" class="text-xs font-bold text-[--bluegray-accent] hover:text-[--bluegray-dark] underline">
                                            Voir le détail
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
        </div>
    </div>
</div>

<div
    id="delete-account-modal"
    data-modal
    class="fixed inset-0 z-70 hidden items-center justify-center px-4 py-8"
    aria-hidden="true"
>
    <div class="absolute inset-0 bg-[--bluegray-dark]/70 backdrop-blur-sm" data-modal-close="delete-account-modal"></div>

    <div class="relative w-full max-w-lg rounded-4xl bg-white shadow-2xl border border-red-100 overflow-hidden">
        <div class="bg-linear-to-r from-red-500 to-rose-500 px-8 py-6 text-white">
            <p class="text-xs font-black uppercase tracking-[0.35em] opacity-80 mb-3">Confirmation</p>
            <h3 class="text-3xl font-black leading-tight">Supprimer définitivement votre compte ?</h3>
        </div>

        <div class="p-8">
            <p class="text-[--bluegray-accent] leading-relaxed mb-6">
                Votre espace Lectis sera désactivé et vos données de profil seront anonymisées. Cette action est irréversible.
            </p>

            <div class="rounded-2xl bg-red-50 border border-red-100 p-5 mb-8">
                <p class="text-sm font-bold text-red-700">
                    Vous perdrez l'accès à votre compte, à vos paramètres et à vos avantages actifs.
                </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 sm:justify-end">
                <button
                    type="button"
                    data-modal-close="delete-account-modal"
                    class="px-6 py-4 rounded-2xl bg-[--bluegray-light] text-[--bluegray-dark] text-sm font-black uppercase tracking-widest hover:bg-[--bluegray-medium]/30 transition-colors"
                >
                    Annuler
                </button>

                <form method="post" action="{{ path('app_compte_supprimer') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                    <button type="submit" class="w-full px-6 py-4 rounded-2xl bg-red-500 text-white text-sm font-black uppercase tracking-widest hover:bg-red-600 transition-colors shadow-lg">
                        Oui, supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}
