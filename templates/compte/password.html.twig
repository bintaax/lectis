{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe | Lectis{% endblock %}

{% block body %}

<div class="bg-[--bluegray-light] min-h-screen py-20 px-6">
    <div class="max-w-xl mx-auto">
        
    

        <div class="bg-white rounded-[2rem] shadow-xl border border-[--bluegray-medium]/20 p-8 md:p-12">
            
            <div class="text-center mb-10">
                <div class="w-16 h-16 bg-[--bluegray-light] rounded-full flex items-center justify-center text-[--bluegray-dark] text-2xl mx-auto mb-4">
                    <i class="fa-solid fa-shield-lock"></i>
                </div>
                <h1 class="text-2xl md:text-3xl font-black text-[--bluegray-dark]">Sécurité du compte</h1>
                <p class="text-[--bluegray-deep] text-sm mt-2">Modifiez votre mot de passe pour protéger vos accès.</p>
            </div>

            {{ form_start(form, {'attr': {'class': 'space-y-2'}}) }}
                
                <div class="space-y-1">
                    {{ form_row(form.ancienPassword, {
                        'label': 'Mot de passe actuel',
                        'attr': {'placeholder': '••••••••'}
                    }) }}
                </div>

                <div class="p-4 bg-[--bluegray-light]/30 rounded-xl border border-[--bluegray-light] mb-6">
                    <p class="text-[10px] uppercase font-black text-[--bluegray-deep] mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-circle-info"></i> Conseil sécurité
                    </p>
                    <p class="text-[11px] text-[--bluegray-accent] leading-tight">
                        Utilisez au moins 8 caractères, incluant des lettres, des chiffres et un caractère spécial.
                    </p>
                </div>

                <div class="space-y-1">
                    {{ form_row(form.nouveauPassword, {
                        'label': 'Nouveau mot de passe',
                        'attr': {'placeholder': '••••••••'}
                    }) }}
                </div>

                <div class="pt-6">
                    <button type="submit" class="w-full py-4 bg-[--bluegray-dark] text-white font-black rounded-2xl hover:bg-[--bluegray-accent] transition-all shadow-lg uppercase tracking-widest text-xs">
                        Mettre à jour le mot de passe
                    </button>
                    
                    <a href="{{ path('app_compte') }}" class="block text-center mt-6 text-[--bluegray-deep] text-xs font-bold hover:underline">
                        Annuler et revenir au profil
                    </a>
                </div>

            {{ form_end(form) }}

        </div>

    </div>
</div>
{% endblock %}
