{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe | Lectis{% endblock %}

{% block body %}

<div class="bg-[--bluegray-light] min-h-screen py-20 px-6">
    <div class="max-w-xl mx-auto">
        
    

        <div class="bg-white rounded-[2rem] shadow-xl border border-[--bluegray-medium]/20 p-8 md:p-12">
            
            <div class="text-center mb-10">
                <div class="w-16 h-16 bg-[--bluegray-light] rounded-full flex items-center justify-center text-[--bluegray-dark] text-2xl mx-auto mb-4">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h1 class="text-2xl md:text-3xl font-black text-[--bluegray-dark]">Sécurité du compte</h1>
                <p class="text-[--bluegray-deep] text-sm mt-2">Modifiez votre mot de passe pour protéger vos accès.</p>
            </div>

            {{ form_start(form, {'attr': {'class': 'space-y-2'}}) }}
                
                <div class="space-y-1">
                    {{ form_label(form.ancienPassword, 'Mot de passe actuel') }}
                    <div class="relative" data-password-toggle>
                        {{ form_widget(form.ancienPassword, {
                            'attr': {
                                'placeholder': '••••••••',
                                'class': 'border px-3 py-2 rounded w-full pr-28'
                            }
                        }) }}
                        <button type="button" data-password-toggle-button class="absolute right-4 top-1/2 z-10 -translate-y-1/2 inline-flex h-10 w-10 items-center justify-center rounded-full text-[--bluegray-accent] hover:text-[--bluegray-dark]">
                            <svg data-password-icon-show xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg data-password-icon-hide xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.584 10.587A2 2 0 0 0 13.414 13.4"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.88 5.09A10.94 10.94 0 0 1 12 5c4.477 0 8.268 2.943 9.542 7a11.06 11.06 0 0 1-4.132 5.411M6.228 6.228A10.95 10.95 0 0 0 2.458 12c1.274 4.057 5.065 7 9.542 7 1.61 0 3.142-.38 4.5-1.057"/>
                            </svg>
                        </button>
                    </div>
                    {{ form_errors(form.ancienPassword) }}
                </div>

                <div class="p-4 bg-[--bluegray-light]/30 rounded-xl border border-[--bluegray-light] mb-6">
                    <p class="text-[10px] uppercase font-black text-[--bluegray-deep] mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-circle-info"></i> Conseil sécurité
                    </p>
                    <p class="text-[11px] text-[--bluegray-accent] leading-tight">
                        Utilisez au moins 8 caractères, incluant des lettres, des chiffres et un caractère spécial.
                    </p>
                </div>

                <div class="space-y-1">
                    {{ form_label(form.nouveauPassword, 'Nouveau mot de passe') }}
                    <div class="relative" data-password-toggle>
                        {{ form_widget(form.nouveauPassword, {
                            'attr': {
                                'placeholder': '••••••••',
                                'class': 'border px-3 py-2 rounded w-full pr-28'
                            }
                        }) }}
                        <button type="button" data-password-toggle-button class="absolute right-4 top-1/2 z-10 -translate-y-1/2 inline-flex h-10 w-10 items-center justify-center rounded-full text-[--bluegray-accent] hover:text-[--bluegray-dark]">
                            <svg data-password-icon-show xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg data-password-icon-hide xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.584 10.587A2 2 0 0 0 13.414 13.4"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.88 5.09A10.94 10.94 0 0 1 12 5c4.477 0 8.268 2.943 9.542 7a11.06 11.06 0 0 1-4.132 5.411M6.228 6.228A10.95 10.95 0 0 0 2.458 12c1.274 4.057 5.065 7 9.542 7 1.61 0 3.142-.38 4.5-1.057"/>
                            </svg>
                        </button>
                    </div>
                    {{ form_errors(form.nouveauPassword) }}
                </div>

                <div class="pt-6">
                    <button type="submit" class="w-full py-4 bg-[--bluegray-dark] text-white font-black rounded-2xl hover:bg-[--bluegray-accent] transition-all shadow-lg uppercase tracking-widest text-xs">
                        Mettre à jour le mot de passe
                    </button>
                    
                    <a href="{{ path('app_compte') }}" class="block text-center mt-6 text-[--bluegray-deep] text-xs font-bold hover:underline">
                        Annuler et revenir au profil
                    </a>
                </div>

            {{ form_end(form) }}

        </div>

    </div>
</div>
{% endblock %}
