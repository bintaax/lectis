{% extends 'base.html.twig' %}

{% block title %}{{ livre.titre }} – Lectis{% endblock %}

{% block body %}
<style>
    :root {
        --bluegray-light:   #EEF3F8;
        --bluegray-medium:  #CDD6E2;
        --bluegray-deep:    #7B8A9A;
        --bluegray-dark:    #2E3A45;
        --bluegray-accent:  #3F5366;
    }
</style>

<div class="bg-[--bluegray-light] min-h-screen">
    
    <div class="max-w-6xl mx-auto px-6 pt-8">
        <a href="{{ path('app_livres') }}" class="inline-flex items-center gap-2 text-[--bluegray-deep] text-sm font-bold hover:text-[--bluegray-dark]">
            <i class="fa-solid fa-chevron-left"></i> 
            Retour au catalogue
        </a>
    </div>

    <section class="max-w-6xl mx-auto px-6 py-8">
        
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-16">

            <div class="w-full lg:w-2/5 flex justify-center lg:block lg:sticky lg:top-10 h-fit">
                <div class="bg-white p-3 md:p-4 rounded-[2rem] shadow-xl border border-[--bluegray-medium]/20 w-full max-w-[320px] lg:max-w-full">
                    <img src="/assets/img/{{ livre.photo }}" 
                         alt="{{ livre.titre }}"
                         class="w-full h-auto aspect-[2/3] object-cover rounded-[1.5rem]">
                </div>
            </div>

            <div class="w-full lg:w-3/5">
                
                <div class="text-center lg:text-left mb-8">
                    <div class="flex flex-wrap justify-center lg:justify-start gap-2 mb-4">
                        <span class="px-3 py-1 bg-[--bluegray-medium]/40 text-[--bluegray-dark] text-[10px] font-bold rounded-full uppercase">
                            {{ livre.genre }}
                        </span>
                        <div class="scale-90 origin-center lg:origin-left">
                            {{ livre.getDisponibiliteBadge()|raw }}
                        </div>
                    </div>
                    <h1 class="text-3xl md:text-5xl font-black text-[--bluegray-dark] mb-2 leading-tight">
                        {{ livre.titre }}
                    </h1>
                    <p class="text-lg text-[--bluegray-deep] font-medium italic">par {{ livre.auteur }}</p>
                </div>

                {% if livre.ageAutorise >= 16 %}
                    <div class="flex items-center gap-3 bg-orange-50 border-l-4 border-orange-400 p-4 rounded-xl mb-8">
                        <span class="text-xl">⚠️</span>
                        <p class="text-orange-900 text-xs md:text-sm font-bold">
                            {% if livre.ageAutorise == 18 %}
                                Contenu réservé aux adultes (18+).
                            {% else %}
                                Scènes pouvant heurter les moins de 16 ans.
                            {% endif %}
                        </p>
                    </div>
                {% endif %}

                <div class="bg-[--bluegray-dark] p-6 rounded-3xl shadow-lg flex flex-col sm:flex-row items-center justify-between gap-6 mb-10">
                    <div class="text-center sm:text-left">
                        <p class="text-[10px] text-[--bluegray-medium] uppercase font-bold tracking-widest">Prix librairie</p>
                        <p class="text-4xl font-black text-white">{{ livre.prix }} €</p>
                    </div>

                    {% if livre.disponibilite %}
                        <button onclick="addToCart({{ livre.id }})"
                                class="w-full sm:w-auto px-8 py-4 bg-white text-[--bluegray-dark] font-black rounded-2xl hover:scale-105 transition-all flex items-center justify-center gap-3 shadow-md">
                            Ajouter au panier 
                            <i class="fa-solid fa-basket-shopping"></i>
                        </button>
                    {% else %}
                        <div class="w-full sm:w-auto px-8 py-4 bg-[--bluegray-deep]/50 text-white/70 font-bold rounded-2xl text-center border border-white/10">
                            Indisponible
                        </div>
                    {% endif %}
                </div>

                <div class="mb-10">
                    <h3 class="text-xs font-black uppercase tracking-widest text-[--bluegray-deep] mb-4 flex items-center gap-2">
                        <span class="w-4 h-px bg-[--bluegray-medium]"></span> Résumé
                    </h3>
                    <p class="text-[--bluegray-accent] leading-relaxed text-sm md:text-base bg-white/40 p-6 rounded-2xl border border-white">
                        {{ livre.resume }}
                    </p>
                </div>

                <div class="pt-6 border-t border-[--bluegray-medium]/30">
                    <h3 class="text-xl font-black text-[--bluegray-dark] mb-6">Détails techniques</h3>
                    <div class="grid grid-cols-2 gap-3 md:gap-4">
                        <div class="bg-white/50 p-4 rounded-xl border border-white flex flex-col">
                            <span class="text-[--bluegray-deep] font-bold text-[10px] uppercase mb-1">Éditeur</span>
                            <span class="text-[--bluegray-dark] font-bold text-sm truncate">{{ livre.editeur }}</span>
                        </div>
                        <div class="bg-white/50 p-4 rounded-xl border border-white flex flex-col">
                            <span class="text-[--bluegray-deep] font-bold text-[10px] uppercase mb-1">Date</span>
                            <span class="text-[--bluegray-dark] font-bold text-sm">{{ livre.datePublication|date('Y') }}</span>
                        </div>
                        <div class="bg-white/50 p-4 rounded-xl border border-white flex flex-col">
                            <span class="text-[--bluegray-deep] font-bold text-[10px] uppercase mb-1">Pages</span>
                            <span class="text-[--bluegray-dark] font-bold text-sm">{{ livre.nbPages }} p.</span>
                        </div>
                        <div class="bg-white/50 p-4 rounded-xl border border-white flex flex-col">
                            <span class="text-[--bluegray-deep] font-bold text-[10px] uppercase mb-1">Langue</span>
                            <span class="text-[--bluegray-dark] font-bold text-sm">Français</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
</div>
{% endblock %}