{% extends 'base.html.twig' %}

{% block title %}FAQ | Lectis{% endblock %}

{% block body %}
<style>
    .faq-page {
        --bluegray-light:   #EEF3F8;
        --bluegray-medium:  #CDD6E2;
        --bluegray-deep:    #7B8A9A;
        --bluegray-dark:    #2E3A45;
        --bluegray-accent:  #3F5366;
        --bluegray-hover :  #293a49;
        --neutral-white:    #FFFFFF;
    }
</style>

<div class="faq-page min-h-screen bg-[--bluegray-light] py-16 px-4">
    <div class="max-w-4xl mx-auto">
        
        {# En-tête de la page #}
        <div class="text-center mb-16">
            
            <h1 class="text-4xl md:text-5xl font-bold text-[--bluegray-dark] mt-4 mb-6">Questions Fréquentes</h1>
            <div class="w-20 h-1.5 bg-[--bluegray-accent] mx-auto rounded-full"></div>
            <p class="mt-6 text-[--bluegray-accent] opacity-80 max-w-lg mx-auto leading-relaxed">
                Tout ce que vous devez savoir sur vos commandes, la livraison et le programme Lectis+.
            </p>
        </div>

        {# Conteneur de l'accordéon #}
        <div class="space-y-4">
            
            {# 1. COMMANDES #}
            <details class="group bg-[--neutral-white] rounded-2xl border border-[--bluegray-medium]/30 shadow-sm overflow-hidden transition-all duration-300 open:shadow-md">
                <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-[--bluegray-dark] list-none">
                    <div class="flex items-center gap-4">
                        <span class="w-10 h-10 flex items-center justify-center bg-[--bluegray-light] rounded-xl text-lg">📚</span>
                        <span>Gestion des commandes</span>
                    </div>
                    <svg class="size-5 text-[--bluegray-deep] transition-transform duration-300 group-open:-rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </summary>

                <div class="px-6 pb-6 pt-2 text-[--bluegray-accent] space-y-6">
                    <div class="border-t border-[--bluegray-light] pt-6">
                        <h4 class="font-bold text-[--bluegray-dark] mb-2">Comment passer une commande ?</h4>
                        <p class="text-sm leading-relaxed opacity-90">Ajoutez vos articles au panier, cliquez sur "Ajouter au panier", puis suivez les étapes de paiement sécurisées.</p>
                    </div>
                    <div>
                        <h4 class="font-bold text-[--bluegray-dark] mb-2">Un livre est-il disponible ?</h4>
                        <p class="text-sm leading-relaxed opacity-90">La disponibilité est affichée en temps réel sur chaque fiche produit. En cas de rupture, un indicateur vous préviendra.</p>
                    </div>
                </div>
            </details>

            {# 2. LIVRAISON #}
            <details class="group bg-[--neutral-white] rounded-2xl border border-[--bluegray-medium]/30 shadow-sm overflow-hidden transition-all duration-300 open:shadow-md">
                <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-[--bluegray-dark] list-none">
                    <div class="flex items-center gap-4">
                        <span class="w-10 h-10 flex items-center justify-center bg-[--bluegray-light] rounded-xl text-lg">🚚</span>
                        <span>Expédition & Délais</span>
                    </div>
                    <svg class="size-5 text-[--bluegray-deep] transition-transform duration-300 group-open:-rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </summary>

                <div class="px-6 pb-6 pt-2 text-[--bluegray-accent] space-y-6">
                    <div class="border-t border-[--bluegray-light] pt-6">
                        <h4 class="font-bold text-[--bluegray-dark] mb-2">Quels sont les délais de livraison ?</h4>
                        <p class="text-sm leading-relaxed opacity-90">Prévoyez entre 2 et 5 jours ouvrés pour la France. Les délais internationaux varient selon la destination finale.</p>
                    </div>
                    <div>
                        <h4 class="font-bold text-[--bluegray-dark] mb-2">Puis-je suivre mon colis ?</h4>
                        <p class="text-sm leading-relaxed opacity-90">Absolument. Dès l'expédition, un numéro de suivi est disponible directement dans votre espace personnel.</p>
                    </div>
                </div>
            </details>

            {# 3. PAIEMENT #}
            <details class="group bg-[--neutral-white] rounded-2xl border border-[--bluegray-medium]/30 shadow-sm overflow-hidden transition-all duration-300 open:shadow-md">
                <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-[--bluegray-dark] list-none">
                    <div class="flex items-center gap-4">
                        <span class="w-10 h-10 flex items-center justify-center bg-[--bluegray-light] rounded-xl text-lg">💳</span>
                        <span>Moyens de paiement</span>
                    </div>
                    <svg class="size-5 text-[--bluegray-deep] transition-transform duration-300 group-open:-rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </summary>

                <div class="px-6 pb-6 pt-2 text-[--bluegray-accent]">
                    <div class="border-t border-[--bluegray-light] pt-6">
                        <h4 class="font-bold text-[--bluegray-dark] mb-2">Quels modes de règlement acceptez-vous ?</h4>
                        <p class="text-sm leading-relaxed opacity-90">Nous acceptons les Cartes Bancaires (Visa, Mastercard), PayPal, ainsi que les cartes cadeaux Lectis.</p>
                    </div>
                </div>
            </details>

            {# 4. RETOURS #}
            <details class="group bg-[--neutral-white] rounded-2xl border border-[--bluegray-medium]/30 shadow-sm overflow-hidden transition-all duration-300 open:shadow-md">
                <summary class="flex cursor-pointer items-center justify-between p-6 font-bold text-[--bluegray-dark] list-none">
                    <div class="flex items-center gap-4">
                        <span class="w-10 h-10 flex items-center justify-center bg-[--bluegray-light] rounded-xl text-lg">🔄</span>
                        <span>Politique de retours</span>
                    </div>
                    <svg class="size-5 text-[--bluegray-deep] transition-transform duration-300 group-open:-rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </summary>

                <div class="px-6 pb-6 pt-2 text-[--bluegray-accent]">
                    <div class="border-t border-[--bluegray-light] pt-6">
                        <h4 class="font-bold text-[--bluegray-dark] mb-2">Puis-je retourner un livre ?</h4>
                        <p class="text-sm leading-relaxed opacity-90">Oui, vous disposez d'un délai de 14 jours après réception pour nous retourner un article, à condition qu'il soit dans son état neuf d'origine.</p>
                    </div>
                </div>
            </details>
        </div>

        {# Section Support supplémentaire #}
        <div class="mt-20 p-10 rounded-[2.5rem] bg-[--bluegray-dark] text-center text-white relative overflow-hidden">
            <div class="relative z-10">
                <h3 class="text-2xl font-bold mb-4">Vous n'avez pas trouvé votre réponse ?</h3>
                <p class="text-[--bluegray-medium] mb-8 opacity-80">Notre équipe est disponible pour vous aider personnellement.</p>
                <a href="{{ path('app_contact') }}" class="inline-block px-10 py-4 bg-[--bluegray-accent] hover:bg-[--bluegray-hover] rounded-xl font-bold transition-all transform hover:-translate-y-1">
                    Contactez-nous
                </a>
            </div>
            {# Décoration de fond #}
            <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full -mr-16 -mt-16"></div>
        </div>

    </div>
</div>
{% endblock %}
