<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Accueil{% endblock %}</title>

        <link rel="icon" href="{{ asset('/assets/img/favicon.png') }}" type="image/png">
        <script src="https://kit.fontawesome.com/783766bfd8.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">

       
         <!-- Charge TailwindCSS via CDN pour appliquer les utilitaires sur toutes les pages. -->
        <script src="https://cdn.tailwindcss.com"></script>
        {% block stylesheets %}{% endblock %}
       
        {% block javascripts %}{% endblock %}

    </head>
   <body class="min-h-screen overflow-x-clip" style="background-color: #EEF3F8;">
    {% include "_partials/_header.html.twig" %}

    <main class="min-h-[calc(100vh-5rem)]">
        {% block body %}
        {% endblock %}
    </main>

    {% include "_partials/_footer.html.twig" %}
    <script src="{{ asset('assets/js/script.js') }}" defer></script>
   </body>

</html>
