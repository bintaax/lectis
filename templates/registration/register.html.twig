{% extends 'base.html.twig' %}

{% block title %}Inscription – Lectis{% endblock %}

{% block body %}
<div class="min-h-screen bg-[--bluegray-light] flex items-center justify-center py-20 px-4">
    <div class="w-full max-w-2xl bg-white shadow-2xl rounded-[2.5rem] p-10 border border-[--bluegray-medium]/20">
        
        <div class="text-center mb-10">
            <h1 class="text-4xl font-black text-[--bluegray-dark] mb-2">Inscription</h1>
            <p class="text-[--bluegray-deep] font-medium italic">Rejoignez l'aventure Lectis.</p>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'grid grid-cols-1 md:grid-cols-2 gap-6'}}) }}

             <div class="md:col-span-1">
                {{ form_label(registrationForm.prenom, 'Prénom', {'label_attr': {'class': 'ml-4 mb-2 text-xs font-black uppercase text-[--bluegray-deep]'}}) }}
                {{ form_widget(registrationForm.prenom, {'attr': {'class': 'w-full px-6 py-4 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none'}}) }}
            </div>

            
            <div class="md:col-span-1">
                {{ form_label(registrationForm.nom, 'Nom', {'label_attr': {'class': 'ml-4 mb-2 text-xs font-black uppercase text-[--bluegray-deep]'}}) }}
                {{ form_widget(registrationForm.nom, {'attr': {'class': 'w-full px-6 py-4 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none'}}) }}
            </div>

         
            <div class="md:col-span-2">
                {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'ml-4 mb-2 text-xs font-black uppercase text-[--bluegray-deep]'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full px-6 py-4 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none'}}) }}
            </div>

            <div class="md:col-span-2">
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'ml-4 mb-2 text-xs font-black uppercase text-[--bluegray-deep]'}}) }}
                <div class="relative" data-password-toggle>
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full px-6 py-4 pr-28 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none'}}) }}
                    <button type="button" data-password-toggle-button class="absolute right-4 top-1/2 z-10 -translate-y-1/2 inline-flex h-10 w-10 items-center justify-center rounded-full text-[--bluegray-accent] hover:text-[--bluegray-dark]">
                        <svg data-password-icon-show xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12Z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg data-password-icon-hide xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.584 10.587A2 2 0 0 0 13.414 13.4"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.88 5.09A10.94 10.94 0 0 1 12 5c4.477 0 8.268 2.943 9.542 7a11.06 11.06 0 0 1-4.132 5.411M6.228 6.228A10.95 10.95 0 0 0 2.458 12c1.274 4.057 5.065 7 9.542 7 1.61 0 3.142-.38 4.5-1.057"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="md:col-span-2 flex items-center px-4">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'w-5 h-5 rounded border-none bg-[--bluegray-light] text-[--bluegray-dark]'}}) }}
                {{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions d\'utilisation', {'label_attr': {'class': 'ml-3 text-sm font-bold text-[--bluegray-deep]'}}) }}
            </div>

            <div class="md:col-span-2">
                <button type="submit" class="w-full py-4 bg-[--bluegray-dark] text-white font-black uppercase tracking-widest rounded-2xl hover:scale-[1.01] transition-all shadow-lg">
                    Créer mon compte
                </button>
                <p class="text-center text-sm text-[--bluegray-deep] mt-6">
                    Déjà inscrit ? <a href="{{path('app_login')}}" class="text-[--bluegray-dark] font-black underline">Se connecter</a>
                </p>
            </div>
        {{ form_end(registrationForm) }}
    </div>
</div>
{% endblock %}
