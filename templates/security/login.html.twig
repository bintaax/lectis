{% extends 'base.html.twig' %}

{% block title %}Connexion – Lectis{% endblock %}

{% block body %}
<div class="min-h-screen bg-[--bluegray-light] flex items-center justify-center py-20 px-4">
    <div class="w-full max-w-md bg-white shadow-2xl rounded-[2.5rem] p-10 border border-[--bluegray-medium]/20">
        
        <div class="text-center mb-10">
            <h1 class="text-4xl font-black text-[--bluegray-dark] mb-2">Bon retour !</h1>
            <p class="text-[--bluegray-deep] font-medium italic">Accédez à votre bibliothèque.</p>
        </div>

        {% if error %}
            <div class="p-4 mb-6 bg-red-50 text-red-700 rounded-xl text-sm font-bold border-l-4 border-red-500">
                Email ou mot de passe incorrect.
            </div>
        {% endif %}

        <form method="post" class="space-y-6">
            <div>
                <label class="block ml-4 mb-2 text-xs font-black uppercase tracking-widest text-[--bluegray-deep]">Email</label>
                <input type="email" name="email" value="{{ last_username }}" required 
                       class="w-full px-6 py-4 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none transition-all">
            </div>

            <div>
                <label class="block ml-4 mb-2 text-xs font-black uppercase tracking-widest text-[--bluegray-deep]">Mot de passe</label>
                <div class="relative" data-password-toggle>
                    <input type="password" name="password" required 
                           class="w-full px-6 py-4 pr-28 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none transition-all">
                    <button type="button" data-password-toggle-button class="absolute right-4 top-1/2 z-10 -translate-y-1/2 inline-flex h-10 w-10 items-center justify-center rounded-full text-[--bluegray-accent] hover:text-[--bluegray-dark]">
                        <svg data-password-icon-show xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12Z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg data-password-icon-hide xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.584 10.587A2 2 0 0 0 13.414 13.4"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.88 5.09A10.94 10.94 0 0 1 12 5c4.477 0 8.268 2.943 9.542 7a11.06 11.06 0 0 1-4.132 5.411M6.228 6.228A10.95 10.95 0 0 0 2.458 12c1.274 4.057 5.065 7 9.542 7 1.61 0 3.142-.38 4.5-1.057"/>
                        </svg>
                    </button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="w-full py-4 bg-[--bluegray-dark] text-white font-black uppercase tracking-widest rounded-2xl hover:scale-[1.02] transition-all shadow-lg">
                Se connecter
            </button>
            
            <p class="text-center text-sm text-[--bluegray-deep] pt-4">
                Pas de compte ? <a href="{{path('app_register')}}" class="text-[--bluegray-dark] font-black underline">S'inscrire</a>
            </p>
        </form>
    </div>
</div>
{% endblock %}
