{% extends 'base.html.twig' %}

{% block title %}Catalogue | Lectis{% endblock %}

{% block body %}
<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .book-card img { transition: transform 0.5s ease; }
    .book-card:hover img { transform: scale(1.05); }

    .search-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 2rem;
    }
</style>

<div class="bg-[--bluegray-light] min-h-screen pb-20">

    {# 1. HEADER #}
    <div class="pt-24 pb-4 px-6 text-center">
        <h1 class="text-2xl md:text-3xl font-black text-[--bluegray-dark] tracking-tight">
            {% if app.user %}
                Ravi de vous revoir, <span class="text-[--bluegray-deep]">{{ app.user.prenom }}</span>
            {% else %}
                Explorez le catalogue <span class="text-[--bluegray-deep]">Lectis</span>
            {% endif %}
        </h1>
    </div>

    {# 2. BARRE DE RECHERCHE STICKY #}
    <div class="sticky top-0 z-40 bg-[--bluegray-light]/80 backdrop-blur-xl py-3 mb-4">
        <div class="max-w-4xl mx-auto px-6">
            <form method="get" action="{{ path('app_livres') }}" class="relative">
                <div class="flex flex-col sm:flex-row gap-2">
                    <div class="relative flex-1">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-[--bluegray-medium]"></i>
                        <input
                            type="text"
                            name="q"
                            value="{{ q }}"
                            placeholder="Titre, auteur..."
                            class="w-full pl-12 pr-4 py-3 rounded-xl border border-[--bluegray-medium]/20 bg-white shadow-sm focus:outline-none focus:border-[--bluegray-dark] transition-all font-medium text-[--bluegray-dark]"
                        >
                    </div>
                    <button type="submit" class="px-6 py-3 rounded-xl bg-[--bluegray-dark] text-white font-bold hover:bg-[--bluegray-deep] transition-all shadow-md uppercase tracking-widest text-2xs">
                        Rechercher
                    </button>
                    {% if q %}
                        <a href="{{ path('app_livres') }}" class="px-4 py-3 rounded-xl bg-white text-red-500 border border-red-100 flex items-center justify-center">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-6">
        
        {# 3. ZONE DE RÉSULTATS (RECHERCHE ACTIVE) #}
        {% if q %}
            <div class="mt-6">
                <h2 class="text-lg font-black text-[--bluegray-dark] mb-6">Résultats pour "{{ q }}"</h2>
                
                {% if resultats is empty %}
                    <div class="bg-white rounded-2xl p-10 border border-[--bluegray-medium]/20 text-center max-w-md mx-auto">
                        <p class="font-bold text-[--bluegray-dark]">Aucun livre trouvé.</p>
                    </div>
                {% else %}
                    <div class="search-grid">
                        {% for livre in resultats %}
                            <div class="book-card group bg-white p-3 rounded-2xl shadow-sm border border-[--bluegray-medium]/10 min-w-[180px] max-w-[220px] flex flex-col transition-all hover:shadow-lg">
                                <a href="{{ path('app_detail', { slug: livre.slug }) }}" class="relative block overflow-hidden rounded-xl aspect-[2/3] bg-[--bluegray-light]">
                                    <img class="w-full h-full object-cover" src="/assets/img/{{ livre.photo }}" alt="{{ livre.titre }}" />
                                </a>
                                <div class="mt-3 flex flex-col grow">
                                    <a href="{{ path('app_detail', { slug: livre.slug }) }}">
                                        <h3 class="text-sm font-bold text-[--bluegray-dark] line-clamp-2 leading-snug min-h-[2.5rem] group-hover:text-[--bluegray-deep]">
                                            {{ livre.titre }}
                                        </h3>
                                    </a>
                                    <p class="text-[--bluegray-deep] text-[10px] font-bold uppercase tracking-wider mt-1 opacity-60">{{ livre.auteur }}</p>
                                    <div class="mt-3 mb-3">
                                        {% if app.user and app.user.isAdherent %}
                                            <div class="flex flex-col">
                                                <div class="flex items-center gap-2">
                                                    {# Changement de couleur Gold ici #}
                                                    <span class="text-lg font-bold text-[#C5A059]">{{ livre.prixFidelite|number_format(2, ',', ' ') }} €</span>
                                                    <span class="text-sm font-bold text-white bg-[#C5A059] px-1.5 py-0.5 rounded uppercase tracking-tighter">Membre</span>
                                                </div>
                                                <span class="text-l text-[--bluegray-medium] line-through">{{ livre.prix|number_format(2, ',', ' ') }} €</span>
                                            </div>
                                        {% else %}
                                            <span class="text-base font-black text-[--bluegray-dark]">{{ livre.prix|number_format(2, ',', ' ') }} €</span>
                                        {% endif %}
                                    </div>
                                    <div class="mb-3">{{ livre.getDisponibiliteBadge()|raw }}</div>
                                    <a href="{{ path('app_detail', { slug: livre.slug }) }}" class="mt-auto w-full py-2.5 bg-[--bluegray-dark] text-white text-[9px] font-black uppercase tracking-widest rounded-xl text-center hover:bg-[--bluegray-deep] transition-all">Explorer</a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# 4. CARROUSELS PAR GENRE #}
        {% if not q %}
            <div class="space-y-2">
                {% for genre, livres in livresParGenre %}
                    {% set genreId = genre|lower|replace({' ':'-'}) %}

                    <section class="py-8">
                        <div class="flex items-center justify-between mb-6">
                            <h2 class="text-xl font-black text-[--bluegray-dark] uppercase tracking-wide">
                                {{ genre }}
                            </h2>
                            <div class="hidden sm:flex gap-2">
                                <button onclick="document.getElementById('{{ genreId }}').scrollBy({left: -300, behavior: 'smooth'})" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-[--bluegray-medium]/20 text-[--bluegray-dark] hover:bg-[--bluegray-dark] hover:text-white transition-all">
                                    <i class="fa-solid fa-chevron-left text-xs"></i>
                                </button>
                                <button onclick="document.getElementById('{{ genreId }}').scrollBy({left: 300, behavior: 'smooth'})" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-[--bluegray-medium]/20 text-[--bluegray-dark] hover:bg-[--bluegray-dark] hover:text-white transition-all">
                                    <i class="fa-solid fa-chevron-right text-xs"></i>
                                </button>
                            </div>
                        </div>

                        <div id="{{ genreId }}" class="flex gap-6 overflow-x-auto scroll-smooth pb-4 no-scrollbar">
                            {% for livre in livres %}
                                <div class="book-card group bg-white p-3 rounded-2xl shadow-sm border border-[--bluegray-medium]/10 min-w-[180px] max-w-[220px] flex flex-col transition-all hover:shadow-lg">
                                    <a href="{{ path('app_detail', { slug: livre.slug }) }}" class="relative block overflow-hidden rounded-xl aspect-[2/3] bg-[--bluegray-light]">
                                        <img class="w-full h-full object-cover" src="/assets/img/{{ livre.photo }}" alt="{{ livre.titre }}" />
                                    </a>
                                    <div class="mt-3 flex flex-col grow">
                                        <a href="{{ path('app_detail', { slug: livre.slug }) }}">
                                            <h3 class="text-sm font-bold text-[--bluegray-dark] line-clamp-2 leading-snug min-h-[2.5rem] group-hover:text-[--bluegray-deep]">
                                                {{ livre.titre }}
                                            </h3>
                                        </a>
                                        <p class="text-[--bluegray-deep] text-[10px] font-bold uppercase tracking-wider mt-1 opacity-60">{{ livre.auteur }}</p>
                                        <div class="mt-3 mb-3">
                                            {% if app.user and app.user.isAdherent %}
                                                <div class="flex flex-col">
                                                    <div class="flex items-center gap-2">
                                                        {# Couleur Gold direct en Hexa #}
                                                        <span class="text-lg font-bold text-[#C5A059]">{{ livre.prixFidelite|number_format(2, ',', ' ') }} €</span>
                                                        <span class="text-sm font-bold text-white bg-[#C5A059] px-1.5 py-0.5 rounded uppercase tracking-tighter">Membre</span>
                                                    </div>
                                                    <span class="text-l text-[--bluegray-medium] line-through">{{ livre.prix|number_format(2, ',', ' ') }} €</span>
                                                </div>
                                            {% else %}
                                                <span class="text-base font-black text-[--bluegray-dark]">{{ livre.prix|number_format(2, ',', ' ') }} €</span>
                                            {% endif %}
                                        </div>
                                        <div class="mb-3">{{ livre.getDisponibiliteBadge()|raw }}</div>
                                        <a href="{{ path('app_detail', { slug: livre.slug }) }}" class="mt-auto w-full py-2.5 bg-[--bluegray-dark] text-white text-[9px] font-black uppercase tracking-widest rounded-xl text-center hover:bg-[--bluegray-deep] transition-all">Explorer</a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}