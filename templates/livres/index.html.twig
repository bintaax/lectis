{% extends 'base.html.twig' %}

{% block title %}Catalogue | Lectis{% endblock %}

{% block body %}
<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .book-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .book-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
    }

    .search-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 2rem;
    }

    @media (max-width: 640px) {
        .search-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
    }
</style>

<div class="bg-[--bluegray-light] min-h-screen pb-20 pt-24">

    {# 1. HEADER #}
    <div class="max-w-7xl mx-auto px-6 mb-12">
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[--bluegray-dark]">
            {% if app.user %}
                Bonjour, <span class="text-[--bluegray-accent]">{{ app.user.prenom }}</span> 👋
            {% else %}
                Explorez le catalogue <span class="text-[--bluegray-accent]">Lectis</span>
            {% endif %}
        </h1>
        <p class="text-[--bluegray-deep] opacity-60 mt-2 italic">
            {{ totalLivres }} livre{{ totalLivres > 1 ? 's' : '' }} disponible{{ totalLivres > 1 ? 's' : '' }}
        </p>
    </div>

    {# 2. BARRE DE RECHERCHE & FILTRES (Sticky) #}
    <div class="sticky top-20 z-30 bg-[--bluegray-light]/80 backdrop-blur-md py-4 mb-8">
        <div class="max-w-7xl mx-auto px-6 space-y-6">
            <form method="get" action="{{ path('app_livres') }}" class="relative max-w-2xl flex gap-2">
                <div class="relative flex-1">
                    <i class="fa-solid fa-magnifying-glass absolute left-5 top-1/2 -translate-y-1/2 text-[--bluegray-accent] opacity-40"></i>
                    <input
                        type="text"
                        name="q"
                        value="{{ q }}"
                        placeholder="Titre, auteur..."
                        class="w-full pl-14 pr-4 py-4 rounded-2xl bg-white shadow-sm border-none focus:ring-2 focus:ring-[--bluegray-dark] transition-all text-sm font-medium"
                    >
                </div>
                <button type="submit" class="px-6 py-4 rounded-2xl bg-[--bluegray-dark] text-white font-bold hover:bg-[--bluegray-deep] transition-all shadow-md text-xs uppercase tracking-widest">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                {% if q or selectedGenreId %}
                    <a href="{{ path('app_livres') }}" class="px-4 py-4 rounded-2xl bg-white text-red-500 border border-red-50/50 flex items-center shadow-sm">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                {% endif %}
            </form>

            <div class="flex items-center gap-3 overflow-x-auto no-scrollbar pb-2">
                <a href="{{ q ? path('app_livres', {'q': q}) : path('app_livres') }}"
                   class="whitespace-nowrap px-6 py-2 rounded-full text-xs font-bold transition-all {{ selectedGenreId is null ? 'bg-[--bluegray-dark] text-white' : 'bg-white text-[--bluegray-accent] hover:bg-[--bluegray-medium]' }}">
                    Tout
                </a>
                {% for genre in genres %}
                    <a href="{{ path('app_livres', q ? {'q': q, 'genre': genre.id} : {'genre': genre.id}) }}"
                       class="whitespace-nowrap px-6 py-2 rounded-full text-xs font-bold transition-all {{ selectedGenreId == genre.id ? 'bg-[--bluegray-dark] text-white' : 'bg-white text-[--bluegray-accent] hover:bg-[--bluegray-medium]' }}">
                        {{ genre.nom }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>

    {# 3. GRILLE #}
    <div class="max-w-7xl mx-auto px-6">
        {% if livres is empty %}
            <div class="bg-white rounded-[3rem] p-20 text-center shadow-sm border border-[--bluegray-medium]/20">
                <p class="font-bold text-[--bluegray-dark]">Aucun livre trouvé.</p>
            </div>
        {% else %}
            <div class="search-grid">
                {% for livre in livres %}
                    <div class="book-card group bg-white rounded-[2.5rem] p-4 flex flex-col h-full shadow-sm">
                        
                        <div class="relative aspect-[3/4] overflow-hidden rounded-[2rem] mb-6 bg-[--bluegray-light]">
                            <img class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" 
                                 src="/assets/img/{{ livre.photo }}" 
                                 alt="{{ livre.titre }}" />
                        </div>

                        <div class="px-2 flex flex-col grow">
                            <div class="mb-3 text-[10px] font-bold uppercase tracking-widest">
                                {{ livre.getDisponibiliteBadge()|raw }}
                            </div>

                            <a href="{{ path('app_detail', { slug: livre.slug }) }}">
                                <h3 class="text-md font-bold text-[--bluegray-dark] leading-tight mb-1 line-clamp-2 group-hover:text-[--bluegray-accent]">
                                    {{ livre.titre }}
                                </h3>
                            </a>
                            <p class="text-[10px] uppercase tracking-widest text-[--bluegray-accent] font-bold opacity-60 mb-6">
                                {{ livre.auteur }}
                            </p>

                            <div class="mt-auto pt-4 border-t border-slate-50 flex items-center justify-between">
                                <div>
                                    {% if app.user and app.user.isAdherent %}
                                        <div class="flex flex-col">
                                            <span class="text-lg font-black text-[--accent-gold]">{{ livre.prixFidelite|number_format(2, ',', ' ') }}€</span>
                                            <span class="text-[10px] text-[--bluegray-medium] line-through">{{ livre.prix|number_format(2, ',', ' ') }}€</span>
                                        </div>
                                    {% else %}
                                        <span class="text-lg font-black text-[--bluegray-dark]">{{ livre.prix|number_format(2, ',', ' ') }}€</span>
                                    {% endif %}
                                </div>

                                <a href="{{ path('app_detail', { slug: livre.slug }) }}" 
                                   class="w-12 h-12 flex items-center justify-center rounded-2xl bg-[--bluegray-light] text-[--bluegray-dark] transition-all group-hover:bg-[--bluegray-dark] group-hover:text-white">
                                    <i class="fa-solid fa-arrow-right-long transition-transform group-hover:translate-x-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# 4. PAGINATION #}
            {% if totalPages > 1 %}
                <nav class="flex justify-center items-center gap-4 mt-16">
                    {% if page > 1 %}
                        <a href="{{ path('app_livres', baseQuery|merge({'page': page - 1})) }}"
                           class="w-12 h-12 flex items-center justify-center rounded-full bg-white shadow-sm hover:bg-[--bluegray-dark] hover:text-white transition-all">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    {% endif %}

                    <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm">
                        {% for pageNumber in 1..totalPages %}
                            {% if pageNumber == 1 or pageNumber == totalPages or (pageNumber >= page - 1 and pageNumber <= page + 1) %}
                                <a href="{{ path('app_livres', baseQuery|merge({'page': pageNumber})) }}"
                                   class="w-8 h-8 flex items-center justify-center rounded-full text-xs font-bold transition-all {{ pageNumber == page ? 'bg-[--bluegray-dark] text-white' : 'hover:bg-[--bluegray-light]' }}">
                                    {{ pageNumber }}
                                </a>
                            {% elseif pageNumber == page - 2 or pageNumber == page + 2 %}
                                <span class="px-1 text-[--bluegray-medium]">…</span>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if page < totalPages %}
                        <a href="{{ path('app_livres', baseQuery|merge({'page': page + 1})) }}"
                           class="w-12 h-12 flex items-center justify-center rounded-full bg-white shadow-sm hover:bg-[--bluegray-dark] hover:text-white transition-all">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    {% endif %}
                </nav>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}