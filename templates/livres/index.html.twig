{% extends 'base.html.twig' %}

{% block title %}Catalogue | Lectis{% endblock %}

{% block body %}
<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .book-card img { transition: transform 0.5s ease; }
    .book-card:hover img { transform: scale(1.05); }
</style>

<div class="bg-[--bluegray-light] min-h-screen pb-20">

    {# MESSAGE DE BIENVENUE #}
    {% if app.user %}
        <div class="pt-12 pb-6 px-6 text-center">
            <h1 class="text-3xl font-black text-[--bluegray-dark]">
                Bienvenue <span class="text-[--bluegray-accent]">{{ app.user.prenom ?? 'Lecteur' }}</span> !
            </h1>
        </div>
    {% endif %}

    {# BOUCLE DES GENRES #}
    {% for genre, livres in livresParGenre %}
        {% set genreId = genre|lower|replace({' ':'-'}) %}

        <section class="px-6 md:px-12 py-10">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-2xl md:text-3xl font-bold text-[--bluegray-dark] flex items-center gap-3">
                    <span class="w-8 h-1 bg-[--bluegray-accent] rounded-full"></span>
                    {{ genre }}
                </h2>
                
                {# BOUTONS DE NAVIGATION SCROLL #}
                <div class="hidden sm:flex gap-2">
                    <button onclick="document.getElementById('{{ genreId }}').scrollBy({left: -300, behavior: 'smooth'})" 
                            class="w-10 h-10 flex items-center justify-center rounded-full bg-white border border-[--bluegray-medium] text-[--bluegray-dark] hover:bg-[--bluegray-dark] hover:text-white transition-all shadow-sm">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button onclick="document.getElementById('{{ genreId }}').scrollBy({left: 300, behavior: 'smooth'})" 
                            class="w-10 h-10 flex items-center justify-center rounded-full bg-white border border-[--bluegray-medium] text-[--bluegray-dark] hover:bg-[--bluegray-dark] hover:text-white transition-all shadow-sm">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            {# CONTENEUR DES LIVRES #}
            <div id="{{ genreId }}" class="flex gap-6 overflow-x-auto scroll-smooth py-4 no-scrollbar">
                {% for livre in livres %}
                    <div class="book-card bg-white p-4 rounded-2xl shadow-sm border border-[--bluegray-medium]/30 min-w-[180px] sm:min-w-[220px] max-w-60 flex flex-col transition-all hover:shadow-xl hover:-translate-y-1">
                        
                        {# IMAGE COUVERTURE #}
                        <a href="{{ path('app_detail', { slug: livre.slug }) }}" class="relative block overflow-hidden rounded-xl bg-[--bluegray-light] aspect-2/3">
                            <img class="w-full h-full object-cover" 
                                 src="/assets/img/{{ livre.photo }}" 
                                 alt="{{ livre.titre }}" />
                        </a>

                        {# DÉTAILS DU LIVRE #}
                        <div class="mt-4 flex flex-col grow">
                            <a href="{{ path('app_detail', { slug: livre.slug }) }}">
                                <h3 class="text-sm sm:text-base font-bold text-[--bluegray-dark] line-clamp-2 hover:text-[--bluegray-accent] transition-colors leading-tight min-h-10">
                                    {{ livre.titre }}
                                </h3>
                            </a>
                            <p class="text-[--bluegray-deep] text-xs mt-1 truncate">{{ livre.auteur }}</p>
                            
                            <div class="mt-4 flex items-center justify-between">{# Affichage du prix normal barré et du prix fidélité #}

                                {# <span class="text-lg font-black text-[--bluegray-dark]">{{ livre.prix }} €</span> #}

            {% if app.user and app.user.isAdherent %}
    {# flex-nowrap empêche le retour à la ligne, items-baseline aligne les prix sur leur base #}
    <div class="flex items-baseline gap-3 whitespace-nowrap">
        <span class="text-2xl font-black text-[--bluegray-dark]">
            {{ livre.prixFidelite|number_format(2, ',', ' ') }} €
        </span>
        
        <span class="text-sm text-[--bluegray-medium] line-through opacity-70">
            {{ livre.prix|number_format(2, ',', ' ') }} €
        </span>

        {# On ajuste un peu la taille du badge pour qu'il ne pousse pas la ligne #}
        <span class="bg-green-100 text-green-700 text-2xs uppercase font-bold px-2 py-0.5 rounded-md self-center">
            -10% 
        </span>
    </div>
{% else %}
    <div class="flex items-center gap-2 whitespace-nowrap">
        <span class="text-lg font-black text-[--bluegray-dark]">
            {{ livre.prix|number_format(2, ',', ' ') }} €
        </span>
    </div>
{% endif %}
                            </div>
                              <div>
                                    {{ livre.getDisponibiliteBadge()|raw }}
                                </div>

                            {# BOUTON D'ACTION #}
                            <a href="{{ path('app_detail', { slug: livre.slug }) }}" 
                               class="mt-4 w-full py-2.5 bg-[--bluegray-accent] hover:bg-[--bluegray-hover] text-white text-xs font-bold rounded-lg text-center transition-all flex items-center justify-center gap-2">
                                Voir le livre
                                <i class="fa-solid fa-arrow-right text-2xs"></i>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endfor %}

</div>
{% endblock %}