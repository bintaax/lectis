{% extends 'base.html.twig' %}

{% block title %}Confirmation de commande | Lectis{% endblock %}

{% block body %}


<div class="bg-[--bluegray-light] min-h-screen flex items-center justify-center py-12 px-6">
    <div class="max-w-3xl w-full bg-white rounded-[2.5rem] shadow-xl border border-[--bluegray-medium]/20 p-8 md:p-16 text-center">
        
        <div class="success-check w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-8">
            <i class="fa-solid fa-check text-4xl"></i>
        </div>

        <h1 class="text-3xl md:text-5xl font-black text-[--bluegray-dark] mb-6 leading-tight">
            Merci pour votre commande, <span class="text-[--bluegray-accent]">{{ app.user.prenom }}</span> ! 📖✨
        </h1>

        <p class="text-lg text-[--bluegray-deep] mb-2 font-medium">
            Votre prochaine aventure littéraire est en route.
        </p>
        <p class="text-[--bluegray-accent] mb-12">
            Le suivi de votre colis est disponible dans votre 
            <a href="{{path('app_compte')}}" class="font-bold text-[--bluegray-dark] underline underline-offset-4 hover:text-[--bluegray-accent] transition-colors">
                espace personnel
            </a>.
        </p>

        <div class="w-16 h-1 bg-[--bluegray-light] mx-auto mb-12 rounded-full"></div>

        <div class="bg-[--bluegray-dark] rounded-4xl p-8 md:p-12 text-white relative overflow-hidden shadow-lg border border-white/5">
    
    <div class="absolute -right-6 -bottom-6 text-white/5 text-[12rem] rotate-12 pointer-events-none">
        <i class="fa-solid fa-book-open"></i>
    </div>

    <div class="relative z-10">
        <h2 class="text-xl md:text-2xl font-bold mb-4 flex items-center justify-center gap-3">
            <span class="text-amber-400">✨</span> Devenez membre Lectis+
        </h2>
        
        <p class="text-[--bluegray-medium] text-sm md:text-base leading-relaxed mb-8 max-w-lg mx-auto">
            Rejoignez notre communauté et cumulez des <span class="text-white font-bold">points lecture</span>, profitez de <span class="text-white font-bold">réductions exclusives</span> et accédez en priorité à nos prochaines pépites littéraires.
        </p>

        <a href="{{path('app_compte_lectis_plus')}}" 
           class="inline-block px-10 py-4 bg-white text-[--bluegray-dark] font-black rounded-2xl hover:bg-[--bluegray-light] hover:scale-105 transition-all shadow-md uppercase tracking-widest text-xs">
            Découvrir mes avantages
        </a>
    </div>
</div>
        <div class="mt-12">
            <a href="{{ path('app_livres') }}" class="text-[--bluegray-deep] font-bold text-sm hover:text-[--bluegray-dark] transition-colors">
                <i class="fa-solid fa-arrow-left mr-2"></i> Continuer de flâner dans la librairie
            </a>
        </div>

    </div>
</div>
{% endblock %}