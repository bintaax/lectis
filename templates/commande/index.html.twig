{% extends 'base.html.twig' %}

{% block title %}Finaliser ma commande | Lectis{% endblock %}

{% block body %}
<style>
    /* Personnalise l'apparence des cartes qui encapsulent les radios de paiement. */
    .payment-methods-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .payment-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem;
        background-color: white;
        border: 2px solid var(--bluegray-light);
        border-radius: 1.25rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .payment-label:hover {
        border-color: var(--bluegray-medium);
    }

    .payment-radio {
        width: 1.25rem !important;
        height: 1.25rem !important;
        margin: 0 !important;
        accent-color: var(--bluegray-dark);
    }

    /* Renforce le contour et l'ombre quand une option de paiement est selectionnee. */
    .payment-option input:checked + .payment-label,
    .payment-option:has(input:checked) .payment-label {
        border-color: var(--bluegray-dark);
        background-color: var(--bluegray-light);
    }
</style>

<div class="bg-[--bluegray-light] min-h-screen py-12">
    <div class="max-w-6xl mx-auto px-6">

        {# Retour au panier #}
        <a href="{{ path('app_panier') }}" class="inline-flex items-center gap-2 text-[--bluegray-deep] text-sm font-bold hover:text-[--bluegray-dark] mb-8 transition-colors">
            <i class="fa-solid fa-chevron-left"></i> 
            Retour au panier
        </a>

        <h1 class="text-3xl md:text-4xl font-black text-[--bluegray-dark] mb-10">Finaliser ma commande</h1>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            
            {# COLONNE GAUCHE : FORMULAIRES (2/3) #}
            <div class="lg:col-span-2 space-y-6">
                
                {# Étape 1 : Identité #}
                <div class="bg-white p-8 rounded-4xl shadow-sm border border-[--bluegray-medium]/20">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-8 h-8 bg-[--bluegray-dark] rounded-full flex items-center justify-center text-white text-sm font-bold">1</div>
                        <h2 class="text-xl font-bold text-[--bluegray-dark]">Vos informations</h2>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="p-4 bg-[--bluegray-light]/30 rounded-2xl border border-[--bluegray-light]">
                            <p class="text-[--bluegray-deep] font-bold uppercase text-2xs mb-1 tracking-widest">Client</p>
                            <p class="text-[--bluegray-dark] font-black">{{ app.user.prenom }} {{ app.user.nom }}</p>
                        </div>
                        <div class="p-4 bg-[--bluegray-light]/30 rounded-2xl border border-[--bluegray-light]">
                            <p class="text-[--bluegray-deep] font-bold uppercase text-2xs mb-1 tracking-widest">Email</p>
                            <p class="text-[--bluegray-dark] font-black truncate">{{ app.user.email }}</p>
                        </div>
                    </div>
                </div>

                {# Étape 2 : Livraison et Paiement #}
                <div class="bg-white p-8 rounded-4xl shadow-sm border border-[--bluegray-medium]/20">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-8 h-8 bg-[--bluegray-dark] rounded-full flex items-center justify-center text-white text-sm font-bold">2</div>
                        <h2 class="text-xl font-bold text-[--bluegray-dark]">Livraison & Paiement</h2>
                    </div>

                    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                        
                        <div class="space-y-4">
                            {{ form_row(form.adresse, {'label': 'Adresse de livraison', 'attr': {'class': 'w-full px-6 py-4 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none'}}) }}
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                {{ form_row(form.codePostal, {'label': 'Code Postal', 'attr': {'class': 'w-full px-6 py-4 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none'}}) }}
                                {{ form_row(form.ville, {'label': 'Ville', 'attr': {'class': 'w-full px-6 py-4 bg-[--bluegray-light]/30 border-2 border-gray-200 rounded-2xl focus:bg-white focus:border-[--bluegray-dark] outline-none'}}) }}
                            </div>
                        </div>

                        <hr class="border-[--bluegray-light] my-8">

                        <h3 class="font-bold text-[--bluegray-dark] mb-4">Mode de paiement</h3>
                        <div class="payment-methods-grid">
                            {% for child in form.paiement %}
                                <div class="payment-option">
                                    <label for="{{ child.vars.id }}" class="payment-label">
                                        <div class="flex items-center gap-3">
                                            {% if 'Carte' in child.vars.label %}
                                                <i class="fa-brands fa-cc-visa text-xl text-[--bluegray-deep]"></i>
                                            {% elseif 'Paypal' in child.vars.label %}
                                                <i class="fa-brands fa-paypal text-xl text-[--bluegray-deep]"></i>
                                            {% else %}
                                                <i class="fa-solid fa-wallet text-xl text-[--bluegray-deep]"></i>
                                            {% endif %}
                                            <span class="font-bold text-[--bluegray-dark]">{{ child.vars.label }}</span>
                                        </div>
                                        {{ form_widget(child, {'attr': {'class': 'payment-radio'}}) }}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>

                        <button type="submit" class="w-full py-5 bg-[--bluegray-dark] text-white font-black rounded-2xl hover:scale-[1.02] transition-all shadow-xl uppercase tracking-widest text-sm mt-8">
                            Confirmer et payer {{ total|number_format(2, ',', ' ') }} €
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>

            {# COLONNE DROITE : RÉCAPITULATIF (1/3) #}
            <div class="lg:col-span-1">
                <div class="bg-white rounded-[2.5rem] shadow-xl border border-[--bluegray-medium]/30 overflow-hidden lg:sticky lg:top-8">
                    <div class="p-6 border-b border-[--bluegray-light]">
                        <h2 class="font-bold text-[--bluegray-dark] flex items-center gap-2">
                            <i class="fa-solid fa-receipt text-[--bluegray-deep]"></i>
                            Votre panier
                        </h2>
                    </div>

                    <div class="p-6 space-y-4 max-h-[350px] overflow-y-auto">
                        {% for ligne in lignes %}
                            <div class="flex justify-between items-start gap-4 text-sm">
                                <div class="flex-1">
                                    <p class="font-bold text-[--bluegray-dark] leading-tight">{{ ligne.livre.titre }}</p>
                                    <p class="text-[--bluegray-deep] text-2xs font-bold uppercase">Qté : {{ ligne.quantite }}</p>
                                </div>
                                
                                <div class="text-right">
                                    {% if app.user and app.user.isAdherent %}
                                        <p class="font-black text-[--bluegray-dark] whitespace-nowrap">
                                            {{ (ligne.livre.prixFidelite * ligne.quantite) | number_format(2, ',', ' ') }} €
                                        </p>
                                        <p class="text-[9px] text-green-600 font-bold uppercase line-through opacity-40">
                                            {{ (ligne.livre.prix * ligne.quantite) | number_format(2, ',', ' ') }} €
                                        </p>
                                    {% else %}
                                        <p class="font-black text-[--bluegray-dark] whitespace-nowrap">
                                            {{ (ligne.livre.prix * ligne.quantite) | number_format(2, ',', ' ') }} €
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="p-8 bg-[--bluegray-dark] text-white">
                        {# Calcul et affichage de la remise 10% #}
                        {% if app.user and app.user.isAdherent %}
                            {% set totalBrut = 0 %}
                            {% for l in lignes %}{% set totalBrut = totalBrut + (l.livre.prix * l.quantite) %}{% endfor %}
                            
                            <div class="flex justify-between items-center mb-3 text-sm opacity-70">
                                <span class="font-bold">Total catalogue</span>
                                <span>{{ totalBrut|number_format(2, ',', ' ') }} €</span>
                            </div>
                            <div class="flex justify-between items-center mb-6 p-3 bg-green-500/10 border border-green-500/20 rounded-xl text-green-400 font-bold text-xs uppercase tracking-widest">
                                <span>Remise Lectis+</span>
                                <span>- {{ (totalBrut - total)|number_format(2, ',', ' ') }} €</span>
                            </div>
                        {% endif %}

                        <div class="flex justify-between items-center">
                            <span class="text-[--bluegray-medium] text-xs uppercase font-black tracking-widest">Total TTC</span>
                            <span class="text-3xl font-black">{{ total | number_format(2, ',', ' ') }} €</span>
                        </div>
                        
                        <div class="mt-6 pt-6 border-t border-white/10 flex items-center justify-center gap-2 text-[9px] text-[--bluegray-medium] uppercase tracking-widest">
                            <i class="fa-solid fa-shield-halved"></i>
                            Paiement 100% sécurisé
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
