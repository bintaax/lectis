{% extends 'base.html.twig' %}

{% block title %}Lectis+ | Votre univers lecture{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f1f5f9] py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
        
        {# Hero Section - Style Bleu Gris Premium #}
        <div class="relative overflow-hidden rounded-[2rem] bg-slate-900 shadow-2xl mb-10">
            {# Subtiles nuances de bleu en fond #}
            <div class="absolute top-0 right-0 h-full w-1/3 bg-gradient-to-l from-blue-500/10 to-transparent"></div>
            <div class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-slate-800 blur-3xl"></div>

            <div class="relative p-8 md:p-16">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10">
                    <div class="max-w-2xl">
                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-blue-500/10 border border-blue-400/20 text-blue-300 text-xs font-bold uppercase tracking-widest mb-6">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                            </span>
                            Programme Membre
                        </span>
                        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 tracking-tight">
                            Lectis <span class="text-blue-400">Plus</span>
                        </h1>
                        <p class="text-lg text-slate-300 leading-relaxed mb-8">
                            Rejoignez une communauté de lecteurs passionnés. 
                            Cumulez des <span class="text-white font-medium border-b border-blue-500/50">points lecture</span> à chaque achat et accédez à des privilèges conçus pour sublimer votre expérience.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <div class="flex items-center gap-2 text-slate-400 text-sm">
                                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                1€ dépensé = 1 point
                            </div>
                            <div class="flex items-center gap-2 text-slate-400 text-sm">
                                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Statuts exclusifs
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex flex-shrink-0">
                        <a href="{{ path('app_compte') }}" class="group bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 px-6 py-3 rounded-xl transition-all duration-300 shadow-xl">
                            <span class="flex items-center gap-2">
                                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                                Retour au compte
                            </span>
                        </a>
                    </div>
                </div>
            </div>

            {# Footer du Hero - Gris Ardoise #}
            <div class="bg-slate-800/50 border-t border-slate-700/50 p-6 md:px-16">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="flex items-center gap-4">
                        <div class="p-2 bg-slate-700 rounded-lg text-blue-400">📖</div>
                        <span class="text-sm font-medium text-slate-300">Bibliothèque Enrichie</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="p-2 bg-slate-700 rounded-lg text-blue-400">⚡</div>
                        <span class="text-sm font-medium text-slate-300">Points Instantanés</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="p-2 bg-slate-700 rounded-lg text-blue-400">🔒</div>
                        <span class="text-sm font-medium text-slate-300">Accès Prioritaires</span>
                    </div>
                </div>
            </div>
        </div>

        {# Cards Section #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            {# Card Points #}
            <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:border-blue-300 transition-colors group">
                <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-500 group-hover:text-white transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Points Lecture</h3>
                <p class="text-slate-500 text-sm leading-relaxed mb-6">Votre fidélité est récompensée. Chaque livre acheté vous rapproche du rang supérieur.</p>
                <div class="py-3 px-4 bg-slate-50 rounded-lg border border-slate-100">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Ratio</span>
                    <p class="text-slate-700 font-semibold">1.00 € = 1.00 Point</p>
                </div>
            </div>

            {# Card Statuts #}
            <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:border-blue-300 transition-colors group">
                <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-500 group-hover:text-white transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Rangs & Privilèges</h3>
                <div class="space-y-3">
                    <div class="flex justify-between items-center text-sm border-b border-slate-50 pb-2">
                        <span class="text-slate-600">Lecteur</span>
                        <span class="text-slate-400 font-medium">Badge Bronze</span>
                    </div>
                    <div class="flex justify-between items-center text-sm border-b border-slate-50 pb-2">
                        <span class="text-slate-600 font-semibold">Passionné</span>
                        <span class="text-blue-600 font-medium">-10%*</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-600">Bibliophile</span>
                        <span class="text-slate-400 font-medium">VIP</span>
                    </div>
                </div>
            </div>

            {# Card Early Access #}
            <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:border-blue-300 transition-colors group">
                <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-500 group-hover:text-white transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Précommandes</h3>
                <p class="text-slate-500 text-sm leading-relaxed mb-6">Ne manquez plus aucune sortie. Les membres Lectis+ accèdent au catalogue 48h avant.</p>
                <span class="text-blue-600 text-sm font-bold flex items-center gap-1 group-hover:gap-2 transition-all">
                    Explorer le futur <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
            </div>
        </div>

        {# Action Block - Design Épuré #}
        <div class="bg-slate-900 rounded-[2rem] p-8 md:p-12 text-center lg:text-left relative overflow-hidden">
            {# Motif de fond léger #}
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#475569 1px, transparent 1px); background-size: 20px 20px;"></div>

            <div class="relative flex flex-col lg:flex-row items-center justify-between gap-8">
                {% if app.user and app.user.isAdherent %}
                    <div class="max-w-xl">
                        <h3 class="text-2xl md:text-3xl font-bold text-white mb-3">Statut Membre Actif</h3>
                        <p class="text-slate-400">Vous faites partie de l'élite. Retrouvez vos avantages exclusifs dans votre tableau de bord.</p>
                    </div>
                    <a href="{{ path('app_compte') }}" class="px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all shadow-lg shadow-blue-900/20">
                        Accéder à mon espace
                    </a>
                {% else %}
                    <div class="max-w-xl">
                        <h3 class="text-2xl md:text-3xl font-bold text-white mb-3">Prêt à commencer ?</h3>
                        <p class="text-slate-400 text-lg">L'adhésion est gratuite et sans engagement. Commencez à cumuler dès aujourd'hui.</p>
                    </div>
                    
                    <div class="flex flex-col sm:flex-row gap-4 w-full lg:w-auto">
                        <form method="post" action="{{ path('app_compte_lectis_plus_adherer') }}" class="contents">
                            <input type="hidden" name="_token" value="{{ csrf_token('lectis_plus_join') }}">
                            <button type="submit" class="px-10 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all shadow-lg shadow-blue-900/20 active:scale-95">
                                Adhérer maintenant
                            </button>
                        </form>
                        <a href="{{ path('app_compte') }}" class="px-10 py-4 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-xl transition-all border border-slate-700">
                            Plus tard
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="mt-8 flex items-center justify-center gap-2 text-slate-400 text-xs italic">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Programme de démonstration. Les avantages commerciaux ne sont pas applicables aux transactions réelles.
        </div>
    </div>
</div>
{% endblock %}